      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CosmosPro.ML.DemandForCast.Extractor\CosmosPro.ML.DemandForCast.Extractor.csproj" />
    <ProjectReference Include="..\..\CosmosPro.ML.DemandForCast.Worker\CosmosPro.ML.DemandForCast.Worker.csproj" />
