<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CosmosPro.ML.DemandForCast.Migrator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CosmosPro.ML.DemandForCast.Engine\CosmosPro.ML.DemandForCast.Engine.csproj" />
    <ProjectReference Include="..\CosmosPro.ML.DemandForCast.ServiceDefaults\CosmosPro.ML.DemandForCast.ServiceDefaults.csproj" />

    <!-- ReferenceOutputAssembly=false porque a saída do .sqlproj é um .dacpac, não um
         assembly: o compilador não tem o que fazer com ele. A referência existe pela
         ordem de build — garante que o .dacpac já esteja gerado quando o target
         IncluiDacpacDoStage abaixo for perguntar onde ele está. -->
    <ProjectReference Include="..\CosmosPro.ML.DemandForCast.Database\CosmosPro.ML.DemandForCast.Database.sqlproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.4.3" />
    <PackageReference Include="Microsoft.SqlServer.DacFx" Version="170.4.83" />

    <!-- Referência direta a uma dependência que ninguém declara, e por isso não era
         publicada. O DacFx foi compilado contra Microsoft.Data.SqlClient 6.1.5, que
         trazia Microsoft.Identity.Client 4.80.0 no pacote; o SqlClient que se resolve
         aqui é o 7.0.1 (vem do Aspire/EF Core 10) e **removeu** essa dependência — MSAL
         virou opcional para quem usa autenticação AAD. O DacFx, porém, continua tocando
         o assembly: `ErrorDetectionStrategyBase.CanRetry` inspeciona exceções do MSAL
         para decidir se um erro de conexão é transitório, e o JIT precisa do tipo ali
         mesmo num deploy que só usa autenticação SQL.
         O resultado no primeiro deploy real foi pior do que uma falha: a conexão com o
         SQL Server falhou (banco ainda subindo), o DacFx foi decidir se repetia, e o
         FileNotFoundException do MSAL **substituiu** o erro de conexão no log — o
         sintoma escondia a causa. Qualquer erro transitório voltaria disfarçado assim.
         A versão é exatamente a 4.80.0 porque é essa a identidade que o DacFx pede
         (`Version=4.80.0.0`). -->
    <PackageReference Include="Microsoft.Identity.Client" Version="4.80.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CosmosPro.ML.DemandForCast.Migrator.Tests" />
  </ItemGroup>

  <!-- O .dacpac precisa viajar dentro da imagem: em produção não há .sqlproj para compilar.
       O caminho vem do próprio .sqlproj (target GetTargetPath), e não de um literal
       `bin\Debug\net10.0\...`, para o migrador não quebrar em silêncio se o projeto
       Database mudar de TFM ou de OutputPath.
       A janela entre ResolveProjectReferences (o .dacpac já foi gerado) e
       AssignTargetPaths (quando Content vira arquivo a copiar) é a única em que dá para
       injetar um Content vindo de outro projeto e ainda assim ser copiado tanto pelo
       build quanto pelo publish. -->
  <Target Name="IncluiDacpacDoStage"
          AfterTargets="ResolveProjectReferences"
          BeforeTargets="AssignTargetPaths">
    <!-- RemoveProperties é o que faz isto funcionar dentro da imagem: a task MSBuild
         propaga as propriedades globais para o projeto filho, e a publicação de container
         define RuntimeIdentifier=linux-x64. O .sqlproj então responde
         `bin/<cfg>/net10.0/linux-x64/...dacpac` — caminho onde ele nunca escreve, porque
         não gera saída por RID. O build morria em MSB3030 procurando um arquivo que estava
         um diretório acima. SelfContained anda junto com o RID e afeta o mesmo cálculo. -->
    <MSBuild Projects="..\CosmosPro.ML.DemandForCast.Database\CosmosPro.ML.DemandForCast.Database.sqlproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration)"
             RemoveProperties="RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_StageDatabaseOutput" />
    </MSBuild>
    <ItemGroup>
      <_StageDacpac Include="@(_StageDatabaseOutput)" Condition="'%(Extension)' == '.dacpac'" />
      <Content Include="@(_StageDacpac)">
        <Link>%(Filename)%(Extension)</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
    <Error Condition="'@(_StageDacpac)' == ''"
           Text="O projeto Database nao devolveu nenhum .dacpac em GetTargetPath. Sem ele o migrador nao tem o schema do Stage para publicar." />
  </Target>

</Project>
