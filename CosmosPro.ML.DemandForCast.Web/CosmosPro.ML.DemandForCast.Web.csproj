<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.4.3" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Radzen.Blazor" Version="10.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- RedeContext e os endpoints de login são internal de propósito (detalhe de DI);
         os testes precisam alcançá-los sem ampliar a API pública. -->
    <InternalsVisibleTo Include="CosmosPro.ML.DemandForCast.Web.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- O extrator entra na imagem como asset: o CI baixa o par exe+manifesto do job que os
         constrói no Windows e os deixa aqui antes de a imagem ser montada, então o .exe que o
         comprador baixa vem sempre do mesmo commit que o backend que o atende.

         FORA de wwwroot de propósito: `MapStaticAssets` serviria os ~118 MB sem autenticação
         a quem descobrisse a URL, e o download é de comprador logado (ExtratorEndpoints).

         O glob não casa nada no F5 e no `dotnet build` comum — a pasta só existe no CI —, e
         isso é o esperado: sem o arquivo, a tela diz que não há extrator disponível. Os
         binários estão no .gitignore; 118 MB por versão no git é inviável.

         O `Remove` antes do `Include` não é redundante: o SDK já globa `**/*.json` como
         `Content` por default (`EnableDefaultContentItems`), então o `manifesto.json`
         entraria DUAS vezes e o build morre com NETSDK1022, "Duplicate 'Content' items were
         included". E isso não aparece em build local nenhum — sem a pasta o glob não casa
         nada, então a falha só existe onde o arquivo existe, que é o CI montando a imagem.
         Foi assim que quebrou na primeira execução. -->
    <Content Remove="Assets\extrator\**" />
    <Content Include="Assets\extrator\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CosmosPro.ML.DemandForCast.ServiceDefaults\CosmosPro.ML.DemandForCast.ServiceDefaults.csproj" />
    <ProjectReference Include="..\CosmosPro.ML.DemandForCast.Engine\CosmosPro.ML.DemandForCast.Engine.csproj" />
  </ItemGroup>

</Project>
