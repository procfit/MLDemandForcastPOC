@page "/admin/extrator"
@attribute [Authorize(Roles = Papeis.PowerUser)]
@inject ExtratorEmbutido Embutido

<PageTitle>Extrator — Administração</PageTitle>

@*
    Tela informativa, sem operação. Aqui existia um formulário para publicar o extrator: o
    operador baixava o .zip do artefato do CI e o enviava, e a apiservice gravava o par
    exe+manifesto num bucket do MinIO.

    Isso acabou porque o extrator passou a ser um asset da imagem — o CI o embute antes de
    montar o container (ver ExtratorEmbutido). Não há mais o que publicar, e por consequência
    não há como o executável estar à frente ou atrás do backend que o atende: os dois vêm do
    mesmo commit.

    A tela sobrevive para responder "qual versão o comprador vai baixar?" sem abrir o Dokploy,
    e para conferir o checksum que a página da sessão mostra a ele.

    Sem @rendermode: nada aqui é interativo, o dado é lido do disco no startup e não muda
    enquanto o processo vive.
*@

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">
        <RadzenText TextStyle="TextStyle.H4" TagName="TagName.H1" class="rz-mb-0">Extrator</RadzenText>
        <HelpTip Text="O extrator é o programa que o comprador roda na máquina que enxerga o PBS para gerar o ZIP da comparação. Ele vem embutido nesta instalação: sobe junto com o backend, no mesmo deploy, e é baixado pela página da sessão." />
    </RadzenStack>

    <RadzenCard Variant="Variant.Outlined">
        <RadzenStack Gap="0.75rem">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Versão nesta instalação</RadzenText>

            @if (Embutido.Versao is not { } versao)
            {
                <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false"
                             data-test="extrator-ausente">
                    Esta instalação não traz o extrator, então o botão de download na página da
                    sessão fica desabilitado — o comprador consegue enviar um ZIP que já tenha,
                    mas não consegue obter o programa por aqui. Em ambiente de desenvolvimento
                    isso é o normal: quem embute o executável é o CI, ao montar a imagem.
                </RadzenAlert>
            }
            else
            {
                <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Wrap="FlexWrap.Wrap">
                    <RadzenStack Gap="0.15rem">
                        <RadzenText TextStyle="TextStyle.Caption">Versão</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-0" data-test="extrator-versao">
                            <b>@versao.Versao</b>
                        </RadzenText>
                    </RadzenStack>
                    <RadzenStack Gap="0.15rem">
                        <RadzenText TextStyle="TextStyle.Caption">Gerada em</RadzenText>
                        <RadzenText TextStyle="TextStyle.Body1" class="rz-mb-0">
                            @versao.GeradoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                        </RadzenText>
                    </RadzenStack>
                </RadzenStack>

                <RadzenStack Gap="0.15rem">
                    <RadzenText TextStyle="TextStyle.Caption">Checksum SHA-256</RadzenText>
                    @* Quebra em qualquer ponto: 64 caracteres hexadecimais não têm espaço
                       onde quebrar, e sem isto a linha estoura a largura do card. *@
                    <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0"
                                Style="font-family: monospace; overflow-wrap: anywhere"
                                data-test="extrator-sha">@versao.Sha256</RadzenText>
                </RadzenStack>

                <RadzenText TextStyle="TextStyle.Caption" class="rz-mb-0">
                    É este o valor que a página da sessão mostra ao comprador, para ele conferir
                    com <code>Get-FileHash</code> na máquina dele.
                </RadzenText>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenCard Variant="Variant.Outlined">
        <RadzenStack Gap="0.5rem">
            <RadzenText TextStyle="TextStyle.H6" class="rz-mb-0">Como atualizar</RadzenText>
            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                Não há publicação separada. O executável é construído pelo CI a cada push em
                <code>main</code> e embutido na imagem da aplicação, então uma versão nova chega
                junto com o próximo deploy do backend — o mesmo clique, o mesmo artefato.
            </RadzenText>
        </RadzenStack>
    </RadzenCard>
</RadzenStack>
