    /// <summary>
    /// Base efetiva das duas colunas de desvio relativo, ao lado da base total. Sem ela, uma
    /// população pesada em linhas de adição exibiria os desvios apurados sobre um
    /// denominador silenciosamente menor que o anunciado na linha.
    /// </summary>
    private static string BaseDoDesvio(OverrideRow r)
    {
        if (r.Figuras is not { } f) return "não apurada";
        var formato = r.Ponderado ? "N2" : "N0";
        return f.Base == 0m
            ? "sem base"
            : $"{f.ComDenominador.ToString(formato)} de {f.Base.ToString(formato)}";
    }

    // --- Drill-down ------------------------------------------------------------

    public sealed record DrillRowA(
        string Chave, int N, double? WapeErp, double? WapeMl, PlacarVitorias? Placar)
    {
        /// <summary>ML perde nesta chave quando o WAPE dele é maior que o do ERP.</summary>
        public bool MlPerde => WapeErp is { } e && WapeMl is { } m && m > e;
    }

    private static IReadOnlyList<string> Dimensoes(CamadaAResultado a)
    {
        var chaves = new HashSet<string>(StringComparer.Ordinal);
        foreach (var k in a.Erp?.PorDimensao?.Keys ?? []) chaves.Add(k);
        foreach (var k in a.Ml?.PorDimensao?.Keys ?? []) chaves.Add(k);
        foreach (var k in a.VitoriaPorDimensao?.Keys ?? []) chaves.Add(k);

        return [.. chaves.OrderBy(k => _ordemDimensoes.IndexOf(k) is var i && i < 0 ? int.MaxValue : i)
                         .ThenBy(k => k, StringComparer.Ordinal)];
    }

    private static IReadOnlyList<DrillRowA> BuildDrillA(CamadaAResultado a, string dim)
    {
        var erp = Fatia(a.Erp?.PorDimensao, dim);
        var ml = Fatia(a.Ml?.PorDimensao, dim);
        var vit = Fatia(a.VitoriaPorDimensao, dim);

        var chaves = new HashSet<string>(erp.Keys, StringComparer.Ordinal);
        chaves.UnionWith(ml.Keys);
        chaves.UnionWith(vit.Keys);

        var rows = new List<DrillRowA>(chaves.Count);
        foreach (var chave in chaves)
        {
            var mErp = erp.GetValueOrDefault(chave);
            var mMl = ml.GetValueOrDefault(chave);
            var placar = vit.GetValueOrDefault(chave);
            var n = Math.Max(mErp?.N ?? 0, mMl?.N ?? 0);
            rows.Add(new DrillRowA(chave, n, mErp?.Wape, mMl?.Wape, placar));
        }

        return [.. rows.OrderByDescending(r => r.N).ThenBy(r => r.Chave, StringComparer.OrdinalIgnoreCase)];
    }

    public sealed record DrillRowB(string Chave, int N, int VitoriasMl, int VitoriasErp)
    {
        public bool MlPerde => VitoriasErp > VitoriasMl;
    }

    private static IReadOnlyList<DrillRowB> BuildDrillB(CamadaBResultado b, string dim)
    {
        var vit = Fatia(b.VitoriaPorDimensao, dim);
        return [.. vit.Select(kv => new DrillRowB(kv.Key, kv.Value.N, kv.Value.VitoriasMl, kv.Value.VitoriasErp))
                      .OrderByDescending(r => r.N)
                      .ThenBy(r => r.Chave, StringComparer.OrdinalIgnoreCase)];
    }

    private static IReadOnlyDictionary<string, T> Fatia<T>(
        IReadOnlyDictionary<string, IReadOnlyDictionary<string, T>>? porDimensao, string dim) =>
        porDimensao is not null && porDimensao.TryGetValue(dim, out var fatia)
            ? fatia
            : new Dictionary<string, T>();

    /// <summary>Se o resultado global (WAPE) favorece o ML — usado só para qualificar o alerta de regressão.</summary>
    private static bool MlVenceGlobal(CamadaAResultado a) =>
        a.Ml?.Global is { } ml && a.Erp?.Global is { } erp && ml.Wape < erp.Wape;

    public void Dispose()
    {
        _timer?.Dispose();
        _cts.Cancel();
        _cts.Dispose();
    }
