    // --- Estado ----------------------------------------------------------------

    private sealed record TreinoOpt(Guid Id, string Label, DateOnly? TreinoAte);

    private sealed record TipoOpt(byte Tipo, string Label);

    private static readonly IReadOnlyList<TipoOpt> _tiposCalculo =
        [.. TipoCalculoErp.Todos.Select(t => new TipoOpt(t, $"{t} — {TipoCalculoErp.Nome(t)}"))];

    private List<TreinoOpt> _treinos = [];
    private Guid _treinoJobId;
    private DateTime _janelaInicio = DateTime.Today.AddDays(-30);
    private DateTime _janelaFim = DateTime.Today;
    private byte _tipoCalculo = TipoCalculoErp.EmaxEseg;
    private int _abaTipo;

    private bool _enqueuing;
    private bool _loading;
    private List<ComparacaoPbsRunView> _jobs = [];

    /// <summary>
    /// Uma execução selecionada por método de cálculo. Slots separados são o que impede
    /// que o resultado de um método apareça na aba do outro — eles nunca se somam.
    /// </summary>
    private readonly Dictionary<byte, ComparacaoPbsRunView> _selecionados = [];

    /// <summary>
    /// Resultado já desserializado, por execução. Sem isto o render desserializa o
    /// <c>ResultadoJson</c> inteiro — com <c>Detalhe</c>, <c>DetalheReconciliacao</c> e
    /// <c>ForaDoHorizonteMl</c> — uma vez por aba a cada tick de 3 s, em cada aba de
    /// navegador aberta. Só entra no cache o JSON já presente: um id cujo resultado ainda
    /// não chegou nunca é memoizado, então a transição "sem resultado → concluído"
    /// dispensa invalidação.
    /// </summary>
    private readonly Dictionary<Guid, ComparacaoResultado?> _resultados = [];

    private ComparacaoResultado? ResultadoDe(ComparacaoPbsRunView run)
    {
        if (run.ResultadoJson is null) return null;
        if (_resultados.TryGetValue(run.Id, out var memoizado)) return memoizado;

        var parseado = ComparisonApiClient.ParseResultado(run.ResultadoJson);
        _resultados[run.Id] = parseado;
        return parseado;
    }

    private Timer? _timer;
    private readonly CancellationTokenSource _cts = new();

    private bool TreinoSelecionadoSemCorte =>
        _treinos.FirstOrDefault(t => t.Id == _treinoJobId) is { TreinoAte: null } && _treinoJobId != Guid.Empty;

    protected override async Task OnInitializedAsync()
    {
        // Prerender roda OnInitializedAsync uma vez antes do circuito interativo; sem
        // este guard a carga inicial acontece duas vezes e o Timer é agendado num
        // componente que será descartado.
        if (!RendererInfo.IsInteractive) return;

        await CarregarTreinosAsync();
        await RefreshAsync();
    }

    /// <summary>
    /// Liga o polling enquanto houver execução pendente ou em processamento, e desliga
    /// quando não houver — que é o que o texto ao lado do título promete. Um timer eterno
    /// sobre uma lista estável só gera round-trip de SignalR por circuito aberto.
    /// </summary>
    private void AjustarPolling()
    {
        var pendente = _jobs.Any(j => j.Status is "Pendente" or "Processando");

        if (pendente && _timer is null)
        {
            _timer = new Timer(async _ => await InvokeAsync(RefreshAsync), null,
                TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }
        else if (!pendente && _timer is not null)
        {
            _timer.Dispose();
            _timer = null;
        }
    }

    private async Task CarregarTreinosAsync()
    {
        try
        {
            var jobs = await TrainingApi.ListAsync(50, _cts.Token);
            _treinos = jobs
                .Where(j => j.Status == "Concluido")
                .Select(j => new TreinoOpt(
                    j.Id,
                    $"{j.DataAgendamento.ToLocalTime():dd/MM HH:mm} · {j.MaxSkus} SKUs · corte {(j.TreinoAte?.ToString("dd/MM/yyyy") ?? "nenhum")} · {j.Id.ToString()[..8]}",
                    j.TreinoAte))
                .ToList();
            if (_treinoJobId == Guid.Empty && _treinos.Count > 0) _treinoJobId = _treinos[0].Id;
        }
        catch (OperationCanceledException) { }
        catch { /* POC: silencia */ }
    }

    private async Task RefreshAsync()
    {
        if (_loading) return;
        _loading = true;
        try
        {
            _jobs = [.. await ComparisonApi.ListAsync(50, _cts.Token)];

            // Uma execução selecionada enquanto processava passa a ter resultado; sem
            // este recarregamento a aba ficaria presa no snapshot sem ResultadoJson.
            foreach (var (tipo, sel) in _selecionados.ToList())
            {
                if (sel.ResultadoJson is not null) continue;
                var atual = _jobs.FirstOrDefault(j => j.Id == sel.Id);
                if (atual is { Status: "Concluido" })
                {
                    var detalhe = await ComparisonApi.GetAsync(sel.Id, _cts.Token);
                    if (detalhe is not null) _selecionados[tipo] = detalhe;
                }
                else if (atual is not null)
                {
                    _selecionados[tipo] = atual;
                }
            }
        }
        catch (OperationCanceledException) { }
        catch { /* POC: silencia polling */ }
        finally
        {
            _loading = false;
            AjustarPolling();
            StateHasChanged();
        }
    }

    private async Task OnSelect(ComparacaoPbsRunView j)
    {
        var detalhe = j.Status == "Concluido" && j.ResultadoJson is null
            ? await ComparisonApi.GetAsync(j.Id, _cts.Token) ?? j
            : j;

        _selecionados[j.TipoCalculo] = detalhe;

        var indice = TipoCalculoErp.Todos.ToList().IndexOf(j.TipoCalculo);
        if (indice >= 0) _abaTipo = indice;
    }

    private async Task Comparar()
    {
        _enqueuing = true;
        try
        {
            var r = await ComparisonApi.EnqueueAsync(
                _treinoJobId,
                DateOnly.FromDateTime(_janelaInicio),
                DateOnly.FromDateTime(_janelaFim),
                _tipoCalculo,
                _cts.Token);

            if (r.Success)
            {
                Notifications.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Comparação enfileirada",
                    Detail = $"Método {TipoCalculoErp.Nome(_tipoCalculo)}. O Worker processa em background.",
                    Duration = 5000,
                });
                await RefreshAsync();
            }
            else
            {
                Notifications.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Não foi possível enfileirar",
                    Detail = string.Join(" ", r.Errors ?? []),
                    Duration = 10000,
                });
            }
        }
        catch (Exception ex)
        {
            Notifications.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Falha ao enfileirar",
                Detail = ex.Message,
                Duration = 8000,
            });
        }
        finally { _enqueuing = false; }
    }

    private static BadgeStyle BadgeFor(string status) => status switch
    {
        "Pendente" => BadgeStyle.Secondary,
        "Processando" => BadgeStyle.Info,
        "Concluido" => BadgeStyle.Success,
        "Falha" => BadgeStyle.Danger,
        _ => BadgeStyle.Light,
    };

