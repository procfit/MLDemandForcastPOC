@* Área técnica desta sessão: previsão contra previsão, com o mesmo desenho do drill-down
   da tela do comparativo (F13) — tabela por dimensão, com a marca de onde o ML perde. *@

<RadzenStack Gap="1rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
        <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0">
            Previsão de venda: o seu ERP contra o ML
        </RadzenText>
        <HelpTip Text="@TipUnidade" />
    </RadzenStack>

    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0">
        Esta parte não depende da quantidade a comprar: ela compara a <strong>venda diária prevista</strong> por
        cada método contra a venda que de fato aconteceu, item por item. É o que continua medível quando a
        cobertura da compra é longa demais para o ML calcular quanto comprar.
    </RadzenText>

    @if (Analise is null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
            Não foi possível ler o detalhe desta comparação, então nenhuma métrica é exibida. Ausência de
            resposta não é resultado zero.
        </RadzenAlert>
    }
    else if (Analise.ItensComPrevisaoMl == 0)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
            Nenhum item desta sugestão recebeu previsão do ML <b>e</b> venda real apurada no mesmo período, então
            não há par a pontuar. Isto não é empate entre os dois métodos: é ausência de medida.
        </RadzenAlert>
    }
    else
    {
        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0">
            Apurado sobre @Analise.ItensComPrevisaoMl.ToString("N0") de @Analise.Itens.ToString("N0") item(ns) da
            sugestão. Os demais ficaram fora por não terem série completa no período, por não caberem no
            orçamento de SKUs do treino, ou por a janela avançar além do histórico importado — o subconjunto é
            este, e as métricas abaixo não falam da população inteira.
        </RadzenText>

        <RadzenDataGrid TItem="BracoLinha" Data="@Bracos(Analise.Global)" AllowPaging="false" Density="Density.Compact">
            <Columns>
                <RadzenDataGridColumn TItem="BracoLinha" Property="Nome" Title="Método">
                    <Template Context="b"><strong>@b.Nome</strong></Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BracoLinha" Title="WAPE" Width="130px" TextAlign="TextAlign.Right">
                    <HeaderTemplate><span>WAPE</span><HelpTip Text="@TipWape" Size="0.85rem" /></HeaderTemplate>
                    <Template Context="b">@Pct(b.Wape)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BracoLinha" Title="MAE (un./dia)" Width="150px" TextAlign="TextAlign.Right">
                    <HeaderTemplate><span>MAE (un./dia)</span><HelpTip Text="@TipMae" Size="0.85rem" /></HeaderTemplate>
                    <Template Context="b">@Num(b.Mae)</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="BracoLinha" Title="Itens" Width="110px" TextAlign="TextAlign.Right">
                    <Template Context="b">@b.N.ToString("N0")</Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>

        <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0">
            Item a item: o ML ficou mais perto em @Analise.VitoriasMl.ToString("N0"), o seu ERP em
            @Analise.VitoriasPbs.ToString("N0"), com @Analise.Empates.ToString("N0") empate(s) em
            @Analise.ItensComPrevisaoMl.ToString("N0") item(ns). Empate conta no total e nunca como vitória.
        </RadzenText>

        @* As aberturas por giro, curva e loja MUDARAM DE CASA: agora vivem no Quadro Resumo.
           O patrocinador pediu copia nos dois lugares e depois concordou com a mudanca — dois
           lugares mostrando os mesmos numeros divergem com o tempo, e a ferramenta passa a dar
           duas respostas para a mesma pergunta. Aqui fica o que e especificamente tecnico: o
           confronto global, a explicacao dos indicadores e a recusa da venda perdida. *@
        <RadzenCard Variant="Variant.Outlined">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Gap="1rem" Wrap="FlexWrap.Wrap">
                <RadzenStack Gap="0.25rem">
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0">
                        Aberturas por giro, por curva e por loja
                    </RadzenText>
                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0">
                        Elas ficam no Quadro Resumo, com o placar e o menor WAPE de cada grupo.
                    </RadzenText>
                </RadzenStack>
                @if (SessaoId is { } id)
                {
                    <RadzenButton Text="Abrir Quadro Resumo" Icon="assessment" Variant="Variant.Outlined"
                                  Size="ButtonSize.Small" data-test="ir-para-quadro-resumo"
                                  Click="@(() => Nav.NavigateTo($"/comparacoes/{id}/resumo"))" />
                }
            </RadzenStack>
        </RadzenCard>

        @* Os dois indicadores já têm tooltip nas colunas, mas tooltip não sai em print nem
           em apresentação — que é onde este quadro é lido. O texto fica visível de propósito. *@
        <RadzenCard Variant="Variant.Outlined">
            <div data-test="interpretar-wape-mae">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0 0 0.75rem 0">
                    Como interpretar WAPE e MAE
                </RadzenText>

                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0 0 0.25rem 0">
                    <strong>WAPE — erro percentual absoluto ponderado.</strong>
                    Soma dos erros absolutos dividida pela soma da venda real. Dá mais peso ao item de maior
                    volume e permite ler o erro do conjunto em percentual. Quanto menor, melhor a precisão.
                    É mais robusto que o MAPE numa grade de farmácia, onde muito item tem giro baixo ou zero
                    e o MAPE estoura.
                </RadzenText>
                <div data-test="leitura-wape" style="margin-bottom: 0.75rem">
                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0">
                        @Analise.Global.LeituraDoWape
                    </RadzenText>
                </div>

                <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0 0 0.25rem 0">
                    <strong>MAE — erro absoluto médio.</strong>
                    Diferença média entre o previsto e o realizado, na unidade do indicador — aqui, unidades
                    por dia. É fácil de ler, mas não é comparável entre itens de giro muito diferente: para
                    isso serve o WAPE.
                </RadzenText>
                <div data-test="leitura-mae">
                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0">
                        @Analise.Global.LeituraDoMae
                    </RadzenText>
                </div>
            </div>
        </RadzenCard>
    }

    <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
        <strong>Venda perdida em reais não é exibida em lugar nenhum desta tela.</strong>
        <div style="margin-top: 0.35rem">
            Ela seria uma <b>estimativa</b>, não uma medida: onde faltou produto ninguém sabe quanto teria
            vendido, e o número sairia do mesmo tipo de modelo de demanda que produziu a decisão de compra. Sob
            essa premissa, o método que prevê mais alto compra mais, fica com menos falta e aparece com menos
            venda perdida — sem ter previsto melhor em nada. O que esta tela mostra é o que sobrou, que é
            observável: unidades em prateleira e o custo de compra delas.
        </div>
    </RadzenAlert>

    @if (Resultado is not null)
    {
        <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-text-secondary-color)">
            Resultado gerado em @Resultado.GeradoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ·
            execução de comparação @Resultado.ComparacaoPbsId.ToString()[..8] ·
            método de cálculo do ERP @Resultado.TipoCalculo ·
            @Resultado.ItensAvaliados.ToString("N0") item(ns) avaliado(s) ·
            @Resultado.ItensComDecisaoMl.ToString("N0") com quantidade calculada pelo ML ·
            @Resultado.ItensComPrevisaoMl.ToString("N0") com previsão do ML
            @if (!string.IsNullOrWhiteSpace(Resultado.UtilidadeDecisaoMl))
            {
                <text> · estado da comparação de compra: @Resultado.UtilidadeDecisaoMl</text>
            }
        </RadzenText>
    }
</RadzenStack>

@code {
    [Parameter] public SessaoAnalise? Analise { get; set; }

    /// <summary>Para o link do Quadro Resumo. Nulo em telas que nao sao de sessao.</summary>
    [Parameter] public Guid? SessaoId { get; set; }

    [Inject] private NavigationManager Nav { get; set; } = default!;

    [Parameter] public SessaoResultadoView? Resultado { get; set; }

    private const string TipUnidade =
        "Um ponto de erro por item (loja, SKU), em unidades por dia sobre o período que a compra deveria " +
        "cobrir. NÃO é comparável com o MAE/RMSE do backtest de treinamento, que usa um ponto por dia: " +
        "promediar o período encolhe a variância e reduz o MAE do mesmo modelo.";
    private const string TipWape =
        "WAPE: soma dos erros absolutos dividida pela soma da venda real. Menor é melhor. Mais robusta que " +
        "MAPE em item de giro baixo ou zero, comum em farma.";
    private const string TipMae =
        "MAE: erro médio em unidades por dia. Fácil de ler, mas não comparável entre itens de giro muito " +
        "diferente — para isso, olhe o WAPE.";

    private sealed record BracoLinha(string Nome, double? Wape, double? Mae, int N);

    private static IReadOnlyList<BracoLinha> Bracos(SessaoFatia global) =>
    [
        new("Seu ERP (PBS)", global.WapePbs, global.MaePbs, global.ItensComPrevisaoMl),
        new("ML (LightGBM)", global.WapeMl, global.MaeMl, global.ItensComPrevisaoMl),
    ];

    /// <summary>Nulo vira texto, nunca traço: "—" numa métrica lê como zero.</summary>
    private static string Pct(double? v) => v is { } d ? d.ToString("P1") : "não apurado";

    private static string Num(double? v) => v is { } d ? d.ToString("N2") : "não apurado";
}
