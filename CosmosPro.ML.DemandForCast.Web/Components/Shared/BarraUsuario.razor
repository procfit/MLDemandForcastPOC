@inject IRedeContext RedeCtx
@inject IServiceScopeFactory Escopos
@inject NavigationManager Nav

<AuthorizeView>
    <Authorized>
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.75rem">

            @* Seletor só para PowerUser: ele é autorizado em todas as redes, então
               escolher é legítimo. Para usuário de rede o escopo vem do cadastro e a
               rede aparece apenas como rótulo.

               Form post, e não handler interativo: a escolha é gravada como claim no
               cookie, o que exige escrever na resposta HTTP. Gravar num campo do
               RedeContext (scoped = por circuito) e recarregar em seguida destruía a
               escolha junto com o circuito. *@
            @if (_ehPowerUser && _redes.Count > 0)
            {
                <RadzenIcon Icon="store" />
                <form method="post" action="/api/auth/rede" style="margin: 0">
                    <input type="hidden" name="retorno" value="@_retorno" />
                    <select name="redeId" class="barra-rede" aria-label="Rede ativa"
                            onchange="this.form.submit()">
                        @foreach (var rede in _redes)
                        {
                            <option value="@rede.Id" selected="@(rede.Id == _redeAtual)">@rede.Nome</option>
                        }
                    </select>
                </form>
            }
            else if (_nomeRede is not null)
            {
                <RadzenBadge Text="@_nomeRede" BadgeStyle="BadgeStyle.Info" />
            }

            <RadzenText TextStyle="TextStyle.Body2" class="rz-mb-0">
                @context.User.Identity?.Name
            </RadzenText>

            @* Logout por form post: limpar o cookie exige resposta HTTP. *@
            <form method="post" action="/api/auth/logout" style="margin: 0">
                <button type="submit" class="rz-button rz-button-sm rz-variant-text rz-base"
                        title="Sair">
                    <span class="rz-button-box">
                        <i class="rzi rz-button-icon-left">logout</i>
                        <span class="rz-button-text">Sair</span>
                    </span>
                </button>
            </form>
        </RadzenStack>
    </Authorized>
</AuthorizeView>

<style>
    .barra-rede {
        min-width: 14rem;
        font: inherit;
        color: var(--rz-text-color);
        background-color: var(--rz-input-background-color, transparent);
        border: var(--rz-input-border, 1px solid var(--rz-border-color, currentColor));
        border-radius: var(--rz-input-border-radius, 4px);
        padding: 0.375rem 0.5rem;
    }
</style>

@code {
    private bool _ehPowerUser;
    private List<Rede> _redes = [];
    private int _redeAtual;
    private string? _nomeRede;
    private string _retorno = "/";

    protected override async Task OnInitializedAsync()
    {
        // A troca volta para a página corrente, como o reload que ela substituiu fazia.
        _retorno = "/" + Nav.ToBaseRelativePath(Nav.Uri);

        try
        {
            _ehPowerUser = await RedeCtx.EhPowerUserAsync();
            _redeAtual = await RedeCtx.GetRedeIdAtualAsync();

            await using var escopo = Escopos.CreateAsyncScope();
            var db = escopo.ServiceProvider.GetRequiredService<EngineDbContext>();

            if (_ehPowerUser)
            {
                _redes = await db.Redes.AsNoTracking().Where(r => r.Ativo).OrderBy(r => r.Nome).ToListAsync();
            }
            else
            {
                _nomeRede = await db.Redes.AsNoTracking()
                    .Where(r => r.Id == _redeAtual).Select(r => r.Nome).FirstOrDefaultAsync();
            }
        }
        catch (InvalidOperationException)
        {
            // Sem rede resolvida (usuário operacional sem vínculo, ou nenhuma rede
            // ativa cadastrada). A barra apenas não mostra o escopo; as páginas de
            // dados exibem o erro real quando tentarem carregar.
        }
    }
}
