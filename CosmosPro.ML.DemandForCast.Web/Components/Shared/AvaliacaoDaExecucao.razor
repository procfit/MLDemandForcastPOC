@using CosmosPro.ML.DemandForCast.Engine.Questionarios
@* Seção G do Quadro Resumo: o veredito rápido do comprador sobre esta execução.

   <b>Nada aqui nomeia uma versão do instrumento.</b> Havia "Questionário V5" cravado no botão
   e na legenda; o patrocinador circulou o botão em vermelho em 16/09/2026 pedindo V6. A
   correção não é trocar o número: a numeração ("V3", "V5", "V6") é controle do documento de
   quem conduz a pesquisa, e não conceito de código — o usuário final não precisa dela, e em
   disponibilidade geral o instrumento não muda mais. Se algum texto voltar a nomear versão
   aqui, ele envelhece na próxima revisão do questionário, que foi exatamente o que aconteceu.

   <b>É isto que conclui a execução</b>, desde 19/09/2026. Antes quem concluía era o envio do
   questionário; o Professor orientou que o questionário passe a ser respondido uma vez só por
   comprador, sobre a experiência acumulada, e com ele por execução o comprador responderia o
   mesmo instrumento a cada simulação. Se este veredito não concluísse, da terceira execução em
   diante nenhuma sessão sairia de AguardandoAvaliacao.

   Nenhuma opção vem pré-selecionada, de propósito: um padrão marcado é uma resposta que a
   ferramenta dá no lugar do participante, e a pesquisa não pode distinguir isso de uma escolha. *@

<RadzenStack Gap="1rem">
    <RadzenText TextStyle="TextStyle.Body1" Style="margin: 0">
        Depois de analisar os resultados desta execução, como você avalia a recomendação de compra
        apresentada pelo Machine Learning?
    </RadzenText>

    <div data-test="opcoes-avaliacao">
        <RadzenRadioButtonList @bind-Value="@_veredito" TValue="string?" Orientation="Orientation.Vertical"
                               Disabled="@_gravando">
            <Items>
                <RadzenRadioButtonListItem Text="Válido" Value="@("Valido")" />
                <RadzenRadioButtonListItem Text="Válido com ressalvas" Value="@("ValidoComRessalvas")" />
                <RadzenRadioButtonListItem Text="Não válido" Value="@("NaoValido")" />
            </Items>
        </RadzenRadioButtonList>
    </div>

    @* Texto pedido pelo patrocinador em 16/09/2026, literal. Continua OPCIONAL: ele pediu o
       enunciado, não a obrigatoriedade, e exigir texto livre para concluir travaria a execução
       por uma caixa vazia. *@
    <RadzenFormField Text="Por favor, indique os pontos fortes e os pontos fracos da execução realizada acima."
                     Variant="Variant.Outlined" Style="width: 100%">
        <RadzenTextArea @bind-Value="@_comentario" Rows="4" MaxLength="4000" Disabled="@_gravando"
                        Style="width: 100%"
                        aria-label="Pontos fortes e pontos fracos desta execução" />
    </RadzenFormField>

    @if (_erro is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false" data-test="erro-avaliacao">@_erro</RadzenAlert>
    }

    <RadzenStack Orientation="Orientation.Horizontal" Gap="0.75rem" AlignItems="AlignItems.Center" Wrap="FlexWrap.Wrap">
        <RadzenButton Text="@(_gravando ? "Registrando…" : "Registrar avaliação")" Icon="how_to_vote"
                      ButtonStyle="ButtonStyle.Primary" Disabled="@(_gravando || _veredito is null)"
                      Click="@RegistrarAsync" data-test="registrar-avaliacao" />

        @* O QUESTIONARIO NAO PERTENCE A ESTA EXECUCAO. E um por comprador, liberado depois de
           N execucoes avaliadas, e a rota nao leva id de sessao nenhum.

           Quando o portao esta fechado a tela EXPLICA em vez de esconder o botao: botao ausente
           le-se como defeito, e a regra escrita le-se como regra. *@
        @if (_questionario is { Selado: true })
        {
            <RadzenButton Text="Ver minhas respostas" Icon="assignment_turned_in" Variant="Variant.Text"
                          data-test="ver-questionario"
                          Click="@(() => Nav.NavigateTo("/questionario"))" />
        }
        else if (_questionario is { Liberado: true })
        {
            <RadzenButton Text="Responder Questionário" Icon="assignment" Variant="Variant.Outlined"
                          data-test="ir-para-questionario"
                          Click="@(() => Nav.NavigateTo("/questionario"))" />
        }
        else if (_questionario is { } q)
        {
            <RadzenText TextStyle="TextStyle.Body2" data-test="questionario-bloqueado"
                        Style="margin: 0; color: var(--rz-text-secondary-color)">
                O questionário sobre o protótipo é liberado depois de
                <strong>@q.MinimoExigido execuções avaliadas</strong> — você tem
                <strong>@q.ExecucoesAvaliadas</strong>.
            </RadzenText>
        }
    </RadzenStack>

    @if (Sessao.FoiAvaliada)
    {
        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem"
                     data-test="avaliacao-registrada">
            <RadzenIcon Icon="task_alt" Style="color: var(--rz-success)" />
            <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; color: var(--rz-text-secondary-color)">
                Avaliada como <strong>@Sessao.VereditoLegivel</strong>@(Sessao.AvaliacaoEm is { } q
                    ? $" em {q.ToLocalTime():dd/MM/yyyy 'às' HH:mm}" : "").
                Registrar de novo substitui esta resposta.
            </RadzenText>
        </RadzenStack>
    }

    <RadzenText TextStyle="TextStyle.Caption" Style="margin: 0; color: var(--rz-text-secondary-color)">
        Esta avaliação se refere a <strong>esta execução</strong>, e é ela que a conclui. O
        Questionário avalia o protótipo como ferramenta e é respondido <strong>uma única
        vez</strong>, depois de pelo menos @QuestionarioCatalogo.MinimoDeExecucoes execuções
        avaliadas.
    </RadzenText>
</RadzenStack>

@code {
    [Parameter] public required SessaoView Sessao { get; set; }

    /// <summary>Recarrega a página depois de gravar — o estado exibido vem do servidor, não daqui.</summary>
    [Parameter] public EventCallback OnRegistrada { get; set; }

    [Inject] private ComparacoesApiClient ComparacoesApi { get; set; } = default!;
    [Inject] private QuestionariosApiClient QuestionariosApi { get; set; } = default!;
    [Inject] private ILogger<AvaliacaoDaExecucao> Logger { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private NotificationService Notifications { get; set; } = default!;

    private string? _veredito;
    private string? _comentario;
    private bool _gravando;
    private string? _erro;
    private QuestionarioView? _questionario;

    protected override async Task OnParametersSetAsync()
    {
        // Pré-carrega o que já foi respondido, para reenviar ser uma correção e não um
        // recomeço. Só quando o campo ainda não foi tocado nesta sessão de tela.
        _veredito ??= Sessao.AvaliacaoVeredito;
        _comentario ??= Sessao.AvaliacaoComentario;

        // GUARD DE PRERENDER, como em Sessao.razor e Questionario.razor: o prerender roda isto
        // antes de o circuito existir, e ali não há usuário resolvido para perguntar o portão.
        if (!RendererInfo.IsInteractive) return;

        // O estado do portão vem do servidor a cada render de parâmetro, e não é cacheado:
        // registrar a Seção G desta execução pode ser justamente o que abre o portão, e a tela
        // precisa refletir isso sem o comprador ter de recarregar à mão.
        //
        // FALHAR AQUI NÃO PODE DERRUBAR A SEÇÃO G. O portão é acessório — o essencial desta
        // tela é o comprador registrar o veredito, que é o que conclui a execução. Uma exceção
        // não tratada no OnParametersSetAsync leva a PÁGINA inteira junto, e o comprador fica
        // sem conseguir avaliar por causa de uma chamada que só decide qual botão desenhar.
        try
        {
            _questionario = await QuestionariosApi.GetAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Não foi possível ler a situação do questionário.");
            _questionario = null;
        }
    }

    private async Task RegistrarAsync()
    {
        if (_veredito is null) return;

        _gravando = true;
        _erro = null;
        try
        {
            var (ok, erro) = await ComparacoesApi.RegistrarAvaliacaoAsync(Sessao.Id, _veredito, _comentario);
            if (ok)
            {
                Notifications.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Avaliação registrada",
                    Detail = "Obrigado. Esta execução está concluída.",
                    Duration = 5000,
                });
                await OnRegistrada.InvokeAsync();
            }
            else
            {
                _erro = erro;
            }
        }
        finally
        {
            _gravando = false;
        }
    }
}
