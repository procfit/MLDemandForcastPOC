@* Detalhe item a item. Paginação e ordenação são do SERVIDOR: a população é a da sugestão
   inteira do ERP e o comprador ordena a tabela para achar o pior item.

   Nenhuma célula do braço de ML pode virar traço ou zero quando o valor é nulo: nulo é
   "não foi possível calcular" e zero é "o ML mandaria não comprar nada". *@
@inject ComparacoesApiClient ComparacoesApi
@inject NavigationManager Nav
@inject ILogger<TabelaItensComparacao> Logger

<RadzenStack Gap="0.75rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0">Item por item</RadzenText>
        <RadzenBadge Text="@ContagemDoRecorte" BadgeStyle="@(_filtro.Algum ? BadgeStyle.Info : BadgeStyle.Light)" IsPill="true" />
        <HelpTip Text="Cada página é buscada no servidor sob demanda, e clicar num cabeçalho refaz a consulta ordenada no banco. Ordene por 'Sobrou' para achar o que mais encalhou." />
        <div style="flex: 1"></div>
        <RadzenButton Click="@ExportarExcel" Icon="table_view" Text="Exportar para Excel"
                      ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small"
                      Disabled="@(_total == 0)" data-test="exportar-itens-excel" />
        <HelpTip Text="Baixa uma planilha .xlsx com EXATAMENTE os itens que os filtros acima selecionaram — não a sugestão inteira. O arquivo traz uma aba de capa dizendo quais filtros estavam aplicados e sobre quantos itens cada total foi apurado, para duas exportações diferentes não ficarem indistinguíveis no seu computador. Onde o ML não pôde ser calculado a célula traz um texto, nunca zero: o Excel se recusa a somá-lo, que é o comportamento correto." />
    </RadzenStack>

    @* --- Filtros combináveis ------------------------------------------------------- *@
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0">Filtros</RadzenText>
        <HelpTip Text="Os filtros são combináveis: escolher Loja 18 e Curva A mostra só os itens que atendem às duas condições ao mesmo tempo. Servem para descobrir onde as diferenças entre PBS e ML se concentram. Departamento não está disponível porque o ERP não exporta esse campo hoje — a extração traz Categoria, e inventar departamento a partir dela seria dado fabricado numa tela de decisão de compra." />

        <RadzenFormField Text="Loja" Variant="Variant.Outlined" Style="width: 140px">
            <RadzenDropDown TValue="int?" Value="@_filtro.LojaId" Data="@_lojas" AllowClear="true"
                            Placeholder="todas" Change="@(v => AplicarAsync(_filtro with { LojaId = (int?)v }))" />
        </RadzenFormField>

        @if (_categoriasDisponiveis.Count > 0)
        {
            <RadzenFormField Text="Categoria" Variant="Variant.Outlined" Style="width: 230px">
                <RadzenDropDown TValue="string" Value="@_filtro.Categoria" Data="@_categoriasDisponiveis"
                                TextProperty="Rotulo" ValueProperty="Valor" AllowClear="true"
                                Placeholder="todas" Change="@(v => AplicarAsync(_filtro with { Categoria = (string?)v }))" />
            </RadzenFormField>
        }

        @if (_curvasDisponiveis.Count > 0)
        {
            <RadzenFormField Text="Curva do ERP" Variant="Variant.Outlined" Style="width: 160px">
                <RadzenDropDown TValue="string" Value="@_filtro.Curva" Data="@_curvasDisponiveis"
                                TextProperty="Rotulo" ValueProperty="Valor" AllowClear="true"
                                Placeholder="todas" Change="@(v => AplicarAsync(_filtro with { Curva = (string?)v }))" />
            </RadzenFormField>
        }

        @if (_fabricantesDisponiveis.Count > 0)
        {
            <RadzenFormField Text="Fabricante" Variant="Variant.Outlined" Style="width: 230px">
                <RadzenDropDown TValue="string" Value="@_filtro.Fabricante" Data="@_fabricantesDisponiveis"
                                TextProperty="Rotulo" ValueProperty="Valor" AllowClear="true"
                                Placeholder="todos" Change="@(v => AplicarAsync(_filtro with { Fabricante = (string?)v }))" />
            </RadzenFormField>
        }

        <RadzenFormField Text="Análise rápida" Variant="Variant.Outlined" Style="width: 200px">
            <RadzenDropDown TValue="string" Value="@_filtro.AnaliseRapida" Data="@OpcoesDeAnalise"
                            TextProperty="Rotulo" ValueProperty="Valor" AllowClear="true"
                            Placeholder="todas" Change="@(v => AplicarAsync(_filtro with { AnaliseRapida = (string?)v }))" />
        </RadzenFormField>

        <RadzenFormField Text="Alerta de mercado" Variant="Variant.Outlined" Style="width: 230px">
            <RadzenDropDown TValue="string" Value="@_filtro.Alerta" Data="@OpcoesDeAlerta"
                            TextProperty="Rotulo" ValueProperty="Valor" AllowClear="true"
                            Placeholder="todos" Change="@(v => AplicarAsync(_filtro with { Alerta = (string?)v }))" />
        </RadzenFormField>

        <RadzenFormField Text="Quem ficou mais perto" Variant="Variant.Outlined" Style="width: 190px">
            <RadzenDropDown TValue="string" Value="@_filtro.MaisPerto" Data="@OpcoesDeMaisPerto"
                            TextProperty="Rotulo" ValueProperty="Valor" AllowClear="true"
                            Placeholder="todos" Change="@(v => AplicarAsync(_filtro with { MaisPerto = (string?)v }))" />
        </RadzenFormField>

        <RadzenFormField Text="Preço unitário" Variant="Variant.Outlined" Style="width: 210px">
            <RadzenDropDown TValue="string" Value="@_filtro.Preco" Data="@OpcoesDePreco"
                            TextProperty="Rotulo" ValueProperty="Valor" AllowClear="true"
                            Placeholder="todos" Change="@(v => AplicarAsync(_filtro with { Preco = (string?)v }))" />
        </RadzenFormField>

        <RadzenFormField Text="Índice vs bairro abaixo de" Variant="Variant.Outlined" Style="width: 190px">
            <RadzenNumeric TValue="decimal?" Value="@_filtro.IndiceAbaixoDe" Step="0.05" Min="0"
                           Placeholder="0,50" ShowUpDown="true"
                           Change="@(v => AplicarAsync(_filtro with { IndiceAbaixoDe = v }))" />
        </RadzenFormField>

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem">
            @* O data-test vive num <span> puro, e nao no RadzenCheckBox: componente Radzen
               nao repassa atributo desconhecido para o DOM, e o seletor do E2E nao acharia
               nada -- falha por timeout, sem dizer o motivo. *@
            <span data-test="filtro-somente-com-alerta">
                <RadzenCheckBox TValue="bool" Value="@_filtro.SomenteComAlerta" Name="somenteComAlerta"
                                Change="@(v => AplicarAsync(_filtro with { SomenteComAlerta = (bool)v }))" />
            </span>
            <RadzenLabel Text="Só com alerta de mercado" Component="somenteComAlerta" Style="cursor: pointer" />
            <HelpTip Text="Mostra só os itens em que a rede vendeu abaixo do que costuma vender naquele bairro, segundo a IQVIA. Item sem dado de mercado NÃO entra neste recorte: ausência de medição não é alerta, e tratá-la como alerta encheria a lista de itens que ninguém mediu." />
        </RadzenStack>

        @if (_filtro.SomenteMlPior)
        {
            @* Este recorte chega por link, e nao por um controle que o comprador tenha mexido.
               Sem dizer isso, a tabela pareceria estar mostrando a sugestao inteira com um
               numero de itens inexplicavelmente pequeno. *@
            <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter"
                         AllowClose="false" Style="margin: 0" data-test="recorte-ml-pior">
                Mostrando apenas os itens em que o <strong>ML deixaria mais sobra que o seu ERP</strong>.
                É o recorte do bloco "Onde o ML foi pior", agora inteiro.
            </RadzenAlert>
        }

        @if (_filtro.Algum)
        {
            <RadzenButton Click="@(() => AplicarAsync(FiltroDeItens.Nenhum))" Icon="filter_alt_off"
                          Text="Limpar filtros" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                          Size="ButtonSize.Small" data-test="limpar-filtros-itens" />
        }
    </RadzenStack>

    @if (_semCategoriaNenhuma)
    {
        @* Categoria é gravada na materialização (o Stage é apagado no import seguinte), então
           comparação executada antes dessa coluna existir não tem o dado. Dizer isso é
           diferente de exibir um filtro vazio, que passaria por defeito. *@
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
            <strong>Esta comparação não tem categoria nos itens.</strong>
            <div style="margin-top: 0.35rem">
                A categoria é gravada quando a comparação é processada, e esta rodou antes de o campo
                existir. Rode uma comparação nova, com o mesmo arquivo, para poder filtrar por categoria.
            </div>
        </RadzenAlert>
    }

    @if (_semMercadoNenhum)
    {
        @* Sem este aviso, o comprador vê três colunas novas com travessão em toda linha e
           conclui que o alerta de mercado não funciona. O que falta é sempre uma das duas
           pontes, e as duas têm conserto diferente. *@
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter"
                     AllowClose="false" data-test="aviso-sem-mercado">
            <strong>Nenhum item desta comparação tem dado de mercado da IQVIA.</strong>
            <div style="margin-top: 0.35rem">
                Isso acontece quando falta uma das duas ligações. <strong>Loja → bairro:</strong> o
                arquivo enviado precisa vir de um extrator que traga o CNPJ das lojas — versões
                antigas não trazem, e sem CNPJ nenhuma loja se liga a um bairro da IQVIA.
                <strong>Produto → código de barras:</strong> o produto precisa ter EAN no cadastro do
                PBS, e a IQVIA precisa ter reportado venda dele naqueles bairros.
                Confira também, na tela <a href="/mercado">Dados de mercado</a>, se existe um mês
                carregado <em>anterior</em> ao mês desta sugestão — a comparação nunca usa o mês da
                própria sugestão.
            </div>
        </RadzenAlert>
    }

    @if (MesDeMercado is { } mesMercado)
    {
        @* Um quadro só, e não três parágrafos de letra miúda. Cada fato aqui muda como o
           comprador age sobre a coluna de alerta, então os três ficam visíveis sem hover: o mês
           contra o qual ele está sendo comparado, sobre quantos itens há medição, e que preço
           NÃO entra na conta. O porquê metodológico de cada um vai nos balões. *@
        <RadzenCard Variant="Variant.Filled" data-test="painel-de-mercado">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                         JustifyContent="JustifyContent.SpaceBetween" Wrap="FlexWrap.Wrap" Gap="0.5rem"
                         Style="margin-bottom: 0.75rem">
                <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                    <RadzenIcon Icon="insights" Style="font-size: 1.1rem; color: var(--rz-text-secondary-color)" />
                    <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0">Mercado IQVIA</RadzenText>
                </RadzenStack>
                <RadzenLink Path="/mercado" Text="Gerenciar dados de mercado" Icon="open_in_new"
                            Style="font-size: 0.8rem" />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" Wrap="FlexWrap.Wrap" Gap="2rem">
                <div data-test="mes-de-mercado">
                    <Totalizador Rotulo="Mês comparado"
                                 Valor="@mesMercado.ToString("MM/yyyy")"
                                 Nota="o último antes da sugestão"
                                 Ajuda="@AjudaDoMes" />
                </div>

                @if (CoberturaDeMercado is { Com: var com, Total: var tot })
                {
                    <div data-test="cobertura-de-mercado">
                        <Totalizador Rotulo="Com medição"
                                     Valor="@($"{com} de {tot} itens")"
                                     Nota="@(com < tot
                                         ? $"os outros {tot - com} aparecem com travessão"
                                         : "todo item do recorte tem medição")"
                                     Ajuda="@AjudaDaCobertura" />
                    </div>
                }

                <div data-test="ressalva-preco-mercado">
                    <Totalizador Rotulo="O alerta verifica"
                                 Valor="Estoque, não preço"
                                 Nota="“sem causa” não valida o seu preço"
                                 Ajuda="@AjudaDoPreco" />
                </div>

                @* Placar de preço pedido pelo patrocinador. TRÊS grupos, e o terceiro não é
                   detalhe: sem ele a soma não fecha com o número de itens medidos, e a tela
                   pareceria errada. Item em que a rede não vendeu nada não tem preço, e não
                   pertence a nenhum dos dois lados. *@
                @if (_totais is { TemPlacarDePreco: true } tp)
                {
                    <div data-test="placar-de-preco">
                        <Totalizador Rotulo="Preço da rede vs IQVIA"
                                     Valor="@($"{tp.ItensComPrecoRedeMenor:N0} menor · {tp.ItensComPrecoRedeMaior:N0} maior")"
                                     Nota="@PlacarDePrecoNota(tp)"
                                     Ajuda="@AjudaDoPlacarDePreco" />
                    </div>
                }
            </RadzenStack>
        </RadzenCard>
    }

    @if (_totais is { } t)
    {
        <RadzenCard Variant="Variant.Filled" data-test="totalizadores-itens">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0">Totais do recorte</RadzenText>
                <HelpTip Text="Somam apenas os itens que os filtros selecionaram, e são recalculados no servidor a cada mudança de filtro. As somas do lado do ML falam só dos itens em que ele pôde ser calculado — o número aparece abaixo de cada uma. Onde o ML não tem cálculo o total aparece como 'sem cálculo do ML' e nunca como zero: zero afirmaria que o ML mandaria não comprar nada, que é o contrário de não haver conta." />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Wrap="FlexWrap.Wrap" class="rz-mt-2">
                <Totalizador Rotulo="Itens analisados" Valor="@($"{t.Itens:N0}")" />
                <Totalizador Rotulo="Compra PBS (un.)" Valor="@Unidades(t.CompraPbsUnidades)" />
                <Totalizador Rotulo="Sobra PBS (un.)" Valor="@Unidades(t.SobraPbsUnidades)" />
                <Totalizador Rotulo="R$ parado PBS" Valor="@Dinheiro(t.SobraPbsValor)"
                             Nota="@SemPrecoDeCompra(t.ItensComValorPbs, t.Itens)" />
            </RadzenStack>

            @* Os números do ML vivem numa faixa própria, e os do PBS aparecem aqui de novo
               recalculados sobre os MESMOS itens. Enquanto os dois grupos dividiam uma faixa
               só, a tela punha o total do PBS (todos os itens) ao lado da soma do ML (os que
               ele calculou) e chamava a subtração de "diferença de sobra" — um número que
               media população, não método. *@
            @if (t.SobraMlUnidades is not null || t.CompraMlUnidades is not null)
            {
                <div class="rz-mt-4" data-test="totalizadores-comparaveis">
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem">
                        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0">
                            Comparação PBS &times; ML &mdash; @ItensComparaveis(t).ToString("N0") item(ns)
                        </RadzenText>
                        <HelpTip Text="@TipComparavel" />
                    </RadzenStack>

                    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0.25rem 0 0">
                        Só os itens em que o ML pôde ser calculado. O PBS aparece aqui recalculado
                        sobre esses mesmos itens — é a única forma de a diferença falar de método
                        em vez de falar de quantos itens entraram em cada lado.
                    </RadzenText>

                    <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Wrap="FlexWrap.Wrap" class="rz-mt-2">
                        <Totalizador Rotulo="Compra PBS (un.)" Valor="@UnidadesOuSemMl(t.CompraPbsComparavelUnidades)" />
                        <Totalizador Rotulo="Compra ML (un.)" Valor="@UnidadesOuSemMl(t.CompraMlUnidades)"
                                     Nota="@($"em {t.ItensComCompraMlPositiva:N0} de {t.ItensComCompraMl:N0} registros; nos demais o ML decidiu zero")" />
                        <Totalizador Rotulo="Diferença de compra (un.)" Valor="@DiferencaUnidades(t.DiferencaCompraUnidades)" />
                        <Totalizador Rotulo="Sobra PBS (un.)" Valor="@UnidadesOuSemMl(t.SobraPbsComparavelUnidades)" />
                        <Totalizador Rotulo="Sobra ML (un.)" Valor="@UnidadesOuSemMl(t.SobraMlUnidades)" />
                        <Totalizador Rotulo="Diferença de sobra (un.)" Valor="@DiferencaUnidades(t.DiferencaSobraUnidades)" />
                        <Totalizador Rotulo="R$ parado PBS" Valor="@Dinheiro(t.SobraPbsComparavelValor)"
                                     Nota="@ApuradoSobreValorMl(t)" />
                        <Totalizador Rotulo="R$ parado ML" Valor="@Dinheiro(t.SobraMlValor)" />
                    </RadzenStack>
                </div>
            }
        </RadzenCard>
    }

    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; color: var(--rz-text-secondary-color)">
        "Sobrou" é o que restou na prateleira no fim do período que a compra deveria cobrir: o que foi
        comprado, mais o que já havia em estoque e o que estava a caminho, menos o que a loja vendeu.
    </RadzenText>

    @if (_erro is not null)
    {
        @* Falha de leitura não pode virar "nenhum item": o EmptyText da grade afirma que a
           comparação não deixou item nenhum, e aqui o que faltou foi a resposta. *@
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">
            <strong>Não foi possível carregar os itens desta comparação.</strong>
            <div style="margin-top: 0.35rem">@_erro</div>
        </RadzenAlert>
    }

    <div data-test="tabela-itens">

    <RadzenDataGrid @ref="_grid" TItem="SessaoItem"
                    Data="@_itens" Count="@_total" LoadData="@LoadData"
                    AllowPaging="true" PageSize="25"
                    AllowSorting="true"
                    IsLoading="@_loading"
                    Density="Density.Compact"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    EmptyText="Esta comparação não deixou nenhum item para detalhar.">
        <Columns>
            <RadzenDataGridColumn TItem="SessaoItem" Property="Sku" Title="Código" Width="120px" />
            <RadzenDataGridColumn TItem="SessaoItem" Property="NomeProduto" Title="Produto" Width="220px">
                <Template Context="i">
                    @if (string.IsNullOrWhiteSpace(i.NomeProduto))
                    {
                        <span style="color: var(--rz-warning)">sem cadastro no ERP</span>
                    }
                    else
                    {
                        @i.NomeProduto
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="Ean" Title="EAN" Width="150px" Sortable="false">
                <HeaderTemplate>
                    <span>EAN</span>
                    <HelpTip Text="Código de barras do cadastro do PBS, copiado quando a comparação foi processada, exatamente como o ERP o grava. Comparações anteriores a esta coluna não têm o dado." Size="0.85rem" />
                </HeaderTemplate>
                <Template Context="i">@Texto(i.Ean)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="Fabricante" Title="Fabricante" Width="170px" Sortable="false">
                <Template Context="i">@Texto(i.Fabricante)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="LojaId" Title="Loja" Width="90px" TextAlign="TextAlign.Right" />
            <RadzenDataGridColumn TItem="SessaoItem" Property="Curva" Title="Curva" Width="90px">
                <Template Context="i">@(string.IsNullOrWhiteSpace(i.Curva) ? "sem curva" : i.Curva)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="Categoria" Title="Categoria" Width="150px" Sortable="false">
                <HeaderTemplate>
                    <span>Categoria</span>
                    <HelpTip Text="Categoria do produto no cadastro do PBS, copiada quando a comparação foi processada. Comparações antigas não têm o dado. Departamento não aparece porque o ERP não exporta esse campo." Size="0.85rem" />
                </HeaderTemplate>
                <Template Context="i">
                    @if (string.IsNullOrWhiteSpace(i.Categoria))
                    {
                        <span style="color: var(--rz-text-tertiary-color)">sem categoria</span>
                    }
                    else
                    {
                        @i.Categoria
                    }
                </Template>
            </RadzenDataGridColumn>
            @* As duas colunas de estoque, lado a lado, como o patrocinador pediu: a primeira
               julga a DECISAO ("ja tinha produto e mandou comprar mais?") e a segunda mostra o
               RESULTADO ("quanto sobrou depois"). Nao sao a mesma pergunta, e por isso nenhuma
               das duas substitui a outra. *@
            <RadzenDataGridColumn TItem="SessaoItem" Property="EstoqueNaSugestao"
                                  Title="Estoque na sugestão" Width="160px" TextAlign="TextAlign.Right">
                <HeaderTemplate>
                    <span>Estoque na sugestão</span>
                    <HelpTip Text="O que o ERP tinha registrado no dia em que gerou a sugestão. Serve para julgar a decisão de compra: comprar muito com a prateleira cheia é diferente de comprar muito com ela vazia." Size="0.85rem" />
                </HeaderTemplate>
                <Template Context="i">@UnidadesOuTraco(i.EstoqueNaSugestao)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="EstoqueNoFimDoPeriodo"
                                  Title="Estoque no fim" Width="150px" TextAlign="TextAlign.Right">
                <HeaderTemplate>
                    <span>Estoque no fim</span>
                    <HelpTip Text="Estoque medido no último dia do período que a compra deveria cobrir. É medição, não estimativa — diferente de 'Sobrou', que é calculado. Zero aqui significa que o item terminou o período zerado; travessão significa que não há registro de estoque naquele dia." Size="0.85rem" />
                </HeaderTemplate>
                <Template Context="i">@UnidadesOuTraco(i.EstoqueNoFimDoPeriodo)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="Cobertura"
                                  Title="Cobertura" Width="130px" TextAlign="TextAlign.Right">
                <HeaderTemplate>
                    <span>Cobertura</span>
                    <HelpTip Text="Quantos dias o estoque que sobrou duraria, no ritmo de venda dos últimos 120 dias. Travessão quando não há estoque medido, não há histórico para a média, ou o item não vendeu nada em 120 dias — neste último caso a coluna ao lado explica." Size="0.85rem" />
                </HeaderTemplate>
                <Template Context="i">
                    @(i.Cobertura is { } d ? $"{d:N0} dias" : "—")
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="AnaliseRapida"
                                  Title="Análise rápida" Width="180px" Sortable="false">
                <HeaderTemplate>
                    <span>Análise rápida</span>
                    <HelpTip Text="Vermelho: 60 dias de cobertura ou mais. Amarelo: de 30 a 59. Verde: abaixo de 30. Cinza: o item tem estoque parado e não vendeu nada em 120 dias — não há cobertura a calcular, e é o caso mais grave. Vazio significa que não deu para avaliar, e não que está tudo bem." Size="0.85rem" />
                </HeaderTemplate>
                <Template Context="i">
                    @if (SinalDaAnalise(i.AnaliseRapida) is { } sinal)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.4rem">
                            <span data-test="analise-rapida" title="@sinal.Titulo"
                                  style="display:inline-block; width:0.7rem; height:0.7rem; border-radius:50%; background:@sinal.Cor; flex:none"></span>
                            <span style="color: var(--rz-text-secondary-color)">@sinal.Rotulo</span>
                        </RadzenStack>
                    }
                    else
                    {
                        @* Sem cor NAO e uma quinta categoria boa: e ausencia de avaliacao, e a
                           tela precisa dizer isso em vez de deixar a celula muda. *@
                        <span style="color: var(--rz-text-tertiary-color)" title="Falta estoque medido no fim do período ou histórico de venda para calcular a média.">não avaliado</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="CompraSugeridaPbs" Title="Comprado (PBS)" Width="140px" TextAlign="TextAlign.Right">
                <Template Context="i">@Unidades(i.CompraSugeridaPbs)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="CompraSugeridaMl" Title="Compraria (ML)" Width="150px" TextAlign="TextAlign.Right">
                <Template Context="i">
                    @if (i.CompraSugeridaMl is { } ml)
                    {
                        @Unidades(ml)
                    }
                    else
                    {
                        <span style="color: var(--rz-text-tertiary-color)">@SemCalculoDoMl</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="VendidoNaJanela" Title="Vendido no período" Width="150px" TextAlign="TextAlign.Right">
                <Template Context="i">@Unidades(i.VendidoNaJanela)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="SobraPbsUnidades" Title="Sobrou (PBS)" Width="130px" TextAlign="TextAlign.Right">
                <Template Context="i">@Unidades(i.SobraPbsUnidades)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="SobraMlUnidades" Title="Sobraria (ML)" Width="140px" TextAlign="TextAlign.Right">
                <Template Context="i">
                    @if (i.SobraMlUnidades is { } ml)
                    {
                        @Unidades(ml)
                    }
                    else
                    {
                        <span style="color: var(--rz-text-tertiary-color)">@SemCalculoDoMl</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="SobraPbsValor" Title="Dinheiro parado" Width="150px" TextAlign="TextAlign.Right">
                <Template Context="i">
                    @if (i.SobraPbsValor is { } valor)
                    {
                        @($"R$ {valor.ToString("N2")}")
                    }
                    else
                    {
                        <span style="color: var(--rz-warning)">sem preço de compra</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Title="Quem ficou mais perto" Width="180px" Sortable="false">
                <Template Context="i">
                    @if (i.MlFicouMaisPerto is null)
                    {
                        <RadzenBadge Text="só o PBS foi calculado" BadgeStyle="BadgeStyle.Light" Shade="Shade.Lighter" IsPill="true" />
                    }
                    else if (i.Empate)
                    {
                        <RadzenBadge Text="empate" BadgeStyle="BadgeStyle.Light" Shade="Shade.Lighter" IsPill="true" />
                    }
                    else if (i.MlFicouMaisPerto is true)
                    {
                        <RadzenBadge Text="ML ficou mais perto" BadgeStyle="BadgeStyle.Success" Shade="Shade.Lighter" IsPill="true" />
                    }
                    else
                    {
                        <RadzenBadge Text="PBS ficou mais perto" BadgeStyle="BadgeStyle.Info" Shade="Shade.Lighter" IsPill="true" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="MercadoIndiceDesempenho"
                                  Title="Índice vs bairro" Width="150px" TextAlign="TextAlign.Right">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <span>Índice vs bairro</span>
                        <HelpTip Text="Quanto este item captura no bairro, comparado com o que a rede captura ali em média. 1,00 = igual ao normal da rede. 0,50 = metade. Abaixo de 0,50 acende alerta. Não é fatia de mercado: o tamanho da rede no bairro está nos dois lados da conta e se cancela, então o que sobra é o desempenho do produto." />
                    </RadzenStack>
                </HeaderTemplate>
                <Template Context="i">
                    @if (i.MercadoIndiceDesempenho is { } ix)
                    {
                        <span title="@DetalheDoMercado(i)"
                              style="@(ix < 0.5m ? "color: var(--rz-danger); font-weight: 600" : null)">
                            @ix.ToString("N2")
                        </span>
                    }
                    else
                    {
                        @* Travessão e nunca zero: zero diria que o item não vende no bairro, o
                           que é uma medição, e ninguém a fez. *@
                        <span style="color: var(--rz-text-tertiary-color)" title="Sem dado de mercado para este item">—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            @* ALERTA AO LADO DO INDICE, pedido do patrocinador em 07/09/2026. Antes esta coluna
               ficava junto de Curva, a dez colunas de distancia do indice que a produz — e o
               alerta NAO e um atributo do item, e a leitura do indice: ele acende quando o indice
               cai abaixo de 0,50 e diz qual causa foi testada. Separados, o comprador via o rotulo
               sem o numero que o justifica e tinha de rolar a tabela para cruzar os dois.

               Isto SUPERA a posicao pedida em 06/09, quando os precos deviam vir logo depois do
               indice: so uma coluna pode ser a primeira, e a que explica o indice ganha. Os precos
               continuam no mesmo bloco de mercado, duas posicoes adiante. *@
            <RadzenDataGridColumn TItem="SessaoItem" Property="MercadoAlerta"
                                  Title="Alerta de mercado" Width="300px">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <span>Alerta de mercado</span>
                        <HelpTip Text="Acende quando o índice fica abaixo de 0,50. Aí o sistema procura a causa numa ordem: primeiro estoque — se houve dia sem estoque no mês comparado, diz possível perda por ruptura; se havia estoque todos os dias, diz sem causa aparente e o item vai para a sua análise; se aquele mês não veio no arquivo, diz estoque não apurado, que NÃO é o mesmo que não houve ruptura. PREÇO NÃO É VERIFICADO: o relatório da IQVIA não traz o preço que cada concorrente cobrou, então sem causa aparente NÃO significa que o preço está certo — significa que estoque não explica, e preço não pôde ser testado." />
                    </RadzenStack>
                </HeaderTemplate>
                <Template Context="i">
                    @if (i.AlertaDeMercadoLegivel is { } rotulo)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenIcon Icon="trending_down" Style="color: var(--rz-danger); font-size: 1rem" />
                            <span style="color: var(--rz-danger)" title="@ExplicacaoDoAlerta(i)"
                                  data-test="alerta-de-mercado">@rotulo</span>
                        </RadzenStack>
                    }
                    else if (i.TemDadoDeMercado)
                    {
                        <span style="color: var(--rz-text-tertiary-color)">dentro do esperado</span>
                    }
                    else
                    {
                        @* "Sem dado" e "dentro do esperado" são afirmações diferentes, e a
                           coluna precisa distingui-las: o comprador não pode ler ausência de
                           medição como aprovação. *@
                        <span style="color: var(--rz-text-tertiary-color)" title="Uma das pontes não fechou: loja sem CNPJ, produto sem código de barras, ou a IQVIA não reportou este item no bairro.">sem dado</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            @* Posicao pedida pelo patrocinador (06/09/2026): no bloco de mercado, logo depois
               do indice — hoje com o alerta entre os dois, ver a nota acima.
               A conta e a dele — valor da IQVIA dividido pelas unidades da IQVIA, nos DOIS
               lados, tirados da mesma planilha. Foi a opcao certa entre as duas que ele
               levantou: a alternativa (preco da rede vindo da base de vendas dela) compararia
               um numero normalizado pela IQVIA com um numero real, e a diferenca passaria a
               medir metodologia em vez de posicionamento de preco. *@
            <RadzenDataGridColumn TItem="SessaoItem" Property="PrecoMedioConcorrentes"
                                  Title="Preço unit. IQVIA" Width="150px" TextAlign="TextAlign.Right"
                                  Sortable="false">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <span>Preço unit. IQVIA</span>
                        <HelpTip Text="Preço médio dos CONCORRENTES neste item, no bairro e mês comparados: o valor que a IQVIA reporta dividido pelas unidades que ela reporta. ATENÇÃO: a IQVIA normaliza preços entre os participantes do painel, então este NÃO é o preço que passou no caixa — é um índice. Ele serve para comparar com a coluna ao lado, que sai do mesmo arquivo e da mesma normalização. Não compare com preço de compra." />
                    </RadzenStack>
                </HeaderTemplate>
                <Template Context="i">@Dinheiro(i.PrecoMedioConcorrentes)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="PrecoMedioRede"
                                  Title="Preço unit. rede" Width="170px" TextAlign="TextAlign.Right"
                                  Sortable="false">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <span>Preço unit. rede</span>
                        <HelpTip Text="Mesmo cálculo, para as bandeiras da própria rede, no mesmo bairro e mês. Travessão quando a rede não vendeu nenhuma unidade daquele item no recorte: sem venda não há preço a calcular, e zero afirmaria que a rede vende de graça." />
                    </RadzenStack>
                </HeaderTemplate>
                <Template Context="i">
                    @if (i.PrecoMedioRede is null)
                    {
                        <span style="color: var(--rz-text-tertiary-color)">—</span>
                    }
                    else
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center"
                                     JustifyContent="JustifyContent.End" Gap="0.3rem">
                            <span>@Dinheiro(i.PrecoMedioRede)</span>
                            @* A seta compara os dois indices entre si, que e a unica comparacao
                               que a metodologia da IQVIA autoriza. Nulo nao acende nada. *@
                            @if (i.RedeMaisCaraQueOMercado is true)
                            {
                                <RadzenIcon Icon="arrow_upward" title="Acima do índice dos concorrentes"
                                            Style="color: var(--rz-danger); font-size: 0.9rem" />
                            }
                            else if (i.RedeMaisCaraQueOMercado is false)
                            {
                                <RadzenIcon Icon="arrow_downward" title="Abaixo do índice dos concorrentes"
                                            Style="color: var(--rz-success); font-size: 0.9rem" />
                            }
                        </RadzenStack>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="MercadoDiasSemEstoque"
                                  Title="Dias sem estoque" Width="150px" TextAlign="TextAlign.Right">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <span>Dias sem estoque</span>
                        <HelpTip Text="ATENÇÃO à janela: são dias sem estoque dentro do MÊS DA IQVIA que está sendo comparado (o mês no rodapé dos filtros), e NÃO no período que esta compra deveria cobrir. São perguntas diferentes: aqui a pergunta é por que vendemos pouco naquele mês, e a ruptura da cobertura da compra aparece na manchete da comparação, acima desta tabela. Travessão significa que aquele mês não veio no histórico de estoque do arquivo enviado — não que havia estoque todos os dias." />
                    </RadzenStack>
                </HeaderTemplate>
                <Template Context="i">
                    @if (i.MercadoDiasSemEstoque is { } d)
                    {
                        <span>@d</span>
                    }
                    else
                    {
                        <span style="color: var(--rz-text-tertiary-color)">—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            @* "Ressalva" e "Dias sem estoque" ficam por ultimo a pedido do patrocinador
               (07/09/2026). Ele havia sugerido REMOVER as duas por parecerem vazias, e recuou
               quando soube o que elas fazem: Ressalva marca a linha que nao e comparavel com as
               outras, e Dias sem estoque e a evidencia do alerta de ruptura. Ficam, no fim, onde
               nao competem com as colunas de decisao. *@
            <RadzenDataGridColumn TItem="SessaoItem" Property="JanelaAlemDoHistorico" Title="Ressalva" Width="170px">
                <Template Context="i">
                    @if (i.JanelaAlemDoHistorico)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenIcon Icon="warning" Style="color: var(--rz-warning); font-size: 1rem" />
                            <span style="color: var(--rz-warning)">período incompleto</span>
                            <HelpTip Size="0.85rem" Text="O período que esta compra deveria cobrir termina depois do último dia de venda que veio no arquivo. A venda deste item sai contada por menos e a sobra, por mais: não compare esta linha com as outras." />
                        </RadzenStack>
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    </div>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public Guid SessaoId { get; set; }

    /// <summary>
    /// Texto no lugar do número quando o braço de ML não existe para a linha. Traço ou zero
    /// aqui leriam como "o ML concordou" e "o ML mandaria não comprar nada" — as duas coisas
    /// que ninguém calculou.
    /// </summary>
    private const string SemCalculoDoMl = "sem cálculo do ML";

    /// <summary>
    /// Texto para o comprador no lugar de <c>ex.Message</c> — a mensagem técnica ("Response
    /// status code does not indicate success…") não diz nada a quem não programa, e vai só
    /// para o log.
    /// </summary>
    private const string ErroDeLeituraParaOComprador =
        "Não deu para buscar esta página de itens agora. Tente novamente em alguns instantes; " +
        "se continuar acontecendo, procure o suporte.";

    private RadzenDataGrid<SessaoItem> _grid = null!;
    private IReadOnlyList<SessaoItem> _itens = [];
    private int _total;
    private int _totalSemFiltro;
    private bool _loading;
    private string? _erro;

    /// <summary>
    /// Recorte pedido de fora — hoje só o bloco "Onde o ML foi pior". Trocar o valor reaplica o
    /// filtro; é a única forma de um componente irmão recortar esta tabela sem os dois
    /// compartilharem estado.
    /// </summary>
    [Parameter] public bool SomenteMlPior { get; set; }

    /// <summary>
    /// Estados da análise rápida em português de comprador. <b>"Não avaliado" é uma opção de
    /// verdade</b>, e não a ausência de filtro: ela lista justamente os itens que a régua não
    /// alcançou, que é o recorte para descobrir por que ela não alcançou.
    /// </summary>
    private static readonly OpcaoDeFiltro[] OpcoesDeAnalise =
    [
        new(Engine.Sessoes.AnaliseRapida.Vermelho, "encalhado (60 dias ou mais)"),
        new(Engine.Sessoes.AnaliseRapida.Amarelo, "atenção (30 a 59 dias)"),
        new(Engine.Sessoes.AnaliseRapida.Verde, "ok (menos de 30 dias)"),
        new(Engine.Sessoes.AnaliseRapida.SemGiro, "sem giro (estoque e zero venda)"),
        new(FiltroDeItens.Ausente, "não avaliado"),
    ];

    /// <summary>
    /// Os alertas, um a um — e não só o "só com alerta" que a caixa de seleção já oferece.
    /// <b>"Sem dado de mercado" e "dentro do esperado" são opções separadas</b>: a primeira não
    /// foi avaliada, a segunda foi e passou. Juntá-las apagaria a diferença que a coluna
    /// inteira existe para mostrar.
    /// </summary>
    private static readonly OpcaoDeFiltro[] OpcoesDeAlerta =
    [
        new(Engine.Mercado.MercadoAlertas.Ruptura, "possível perda por ruptura"),
        new(Engine.Mercado.MercadoAlertas.SemCausa, "sem causa aparente"),
        new(Engine.Mercado.MercadoAlertas.NaoApurado, "estoque não apurado"),
        new(Engine.Mercado.MercadoAlertas.SemAlerta, "dentro do esperado"),
        new(FiltroDeItens.Ausente, "sem dado de mercado"),
    ];

    private static readonly OpcaoDeFiltro[] OpcoesDeMaisPerto =
    [
        new("ML", "o ML ficou mais perto"),
        new("PBS", "o seu ERP ficou mais perto"),
        new("Empate", "empate"),
        new(FiltroDeItens.Ausente, "sem cálculo do ML"),
    ];

    private static readonly OpcaoDeFiltro[] OpcoesDePreco =
    [
        new("RedeMenor", "rede mais barata que o mercado"),
        new("IqviaMenor", "mercado mais barato que a rede"),
    ];

    private IReadOnlyList<OpcaoDeFiltro> _fabricantesDisponiveis = [];

    private FiltroDeItens _filtro = FiltroDeItens.Nenhum;
    private bool _mlPiorAplicado;
    private TotaisDosItens? _totais;
    private IReadOnlyList<int> _lojas = [];
    private IReadOnlyList<OpcaoDeFiltro> _categoriasDisponiveis = [];
    private IReadOnlyList<OpcaoDeFiltro> _curvasDisponiveis = [];
    private bool _semCategoriaNenhuma;

    /// <summary>
    /// Uma opção de dropdown. <c>Valor</c> pode ser o sentinela de ausência, e é por isso que
    /// rótulo e valor são campos separados: "sem categoria" precisa aparecer legível na tela e
    /// viajar como <c>FiltroDeItens.Ausente</c> na consulta.
    /// </summary>
    private sealed record OpcaoDeFiltro(string Valor, string Rotulo);

    /// <summary>
    /// "12 de 20.153 itens" quando há filtro; só o total quando não há. O denominador é o que
    /// diz ao comprador se ele está olhando um recorte ou a sugestão inteira.
    /// </summary>
    private string ContagemDoRecorte => _filtro.Algum
        ? $"{_total:N0} de {_totalSemFiltro:N0} itens"
        : $"{_total:N0} itens";

    /// <summary>
    /// Aplica o recorte pedido de fora. Guarda o que já foi aplicado para não sobrescrever o
    /// filtro toda vez que o pai renderiza — sem isso, mexer em qualquer outro filtro seria
    /// desfeito no render seguinte.
    /// </summary>
    protected override async Task OnParametersSetAsync()
    {
        if (SomenteMlPior && !_mlPiorAplicado)
        {
            _mlPiorAplicado = true;
            await AplicarAsync(_filtro with { SomenteMlPior = true });
        }
    }

    private async Task AplicarAsync(FiltroDeItens novo)
    {
        _filtro = novo;
        // Volta para a primeira página: manter a página 7 depois de filtrar para 12 itens
        // renderizaria uma tabela vazia com paginador dizendo que há dados.
        if (_grid is not null)
        {
            await _grid.FirstPage(true);
        }
    }

    private void ExportarExcel()
    {
        // forceLoad: é um endpoint HTTP comum, não rota Blazor. Sem isso o router tentaria
        // resolvê-la no circuito e cairia em "página não encontrada".
        Nav.NavigateTo($"/comparacoes/{SessaoId}/itens/excel{QueryDoFiltro()}", forceLoad: true);
    }

    /// <summary>
    /// O recorte da tela, no formato de fio de <see cref="FiltroDeItens.ParaQueryString"/>.
    ///
    /// <para>
    /// <b>Reaproveita aquele método de propósito.</b> Esta função montava a query à mão com
    /// três dos filtros, e os demais eram descartados em silêncio: o comprador filtrava,
    /// exportava e recebia a sugestão inteira, com a capa da planilha desmentindo o que ele
    /// acabava de ver na tela. Com um único formato de fio, filtro novo entra nos dois
    /// caminhos de uma vez.
    /// </para>
    /// </summary>
    private string QueryDoFiltro()
    {
        var q = _filtro.ParaQueryString();

        // ParaQueryString devolve "&a=1&b=2", pensado para concatenar depois de um parametro
        // que ja existe; aqui ele abre a query.
        return q.Length == 0 ? "" : "?" + q.TrimStart('&');
    }

    private async Task CarregarFiltrosAsync()
    {
        try
        {
            var d = await ComparacoesApi.GetFiltrosDeItensAsync(SessaoId);
            if (d is null) return;

            _lojas = d.Lojas;
            _categoriasDisponiveis =
            [
                .. d.Categorias.Select(c => new OpcaoDeFiltro(c, c)),
                .. d.TemItemSemCategoria && d.Categorias.Count > 0
                    ? new[] { new OpcaoDeFiltro(FiltroDeItens.Ausente, "sem categoria") }
                    : [],
            ];
            _curvasDisponiveis =
            [
                .. d.Curvas.Select(c => new OpcaoDeFiltro(c, c)),
                .. d.TemItemSemCurva && d.Curvas.Count > 0
                    ? new[] { new OpcaoDeFiltro(FiltroDeItens.Ausente, "sem curva") }
                    : [],
            ];
            _fabricantesDisponiveis =
            [
                .. (d.Fabricantes ?? []).Select(f => new OpcaoDeFiltro(f, f)),
                .. d.TemItemSemFabricante && (d.Fabricantes?.Count ?? 0) > 0
                    ? new[] { new OpcaoDeFiltro(FiltroDeItens.Ausente, "sem fabricante") }
                    : [],
            ];
            _semCategoriaNenhuma = d.TemItemSemCategoria && d.Categorias.Count == 0;
        }
        catch (Exception ex)
        {
            // Falha aqui não pode derrubar a tabela: sem as opções o comprador perde os
            // filtros, não os itens.
            Logger.LogError(ex, "Falha ao buscar filtros da sessao {SessaoId}", SessaoId);
        }
    }

    /// <summary>
    /// Dispara a primeira página à mão. A grade só chama <c>LoadData</c> sozinha quando
    /// <c>Data</c> chega nula, e aqui ela chega numa lista vazia — sem este
    /// <c>Reload</c> a tabela renderizava o <c>EmptyText</c> ("não deixou nenhum item")
    /// sem nunca ter perguntado ao servidor, que é a mentira mais barata desta tela.
    ///
    /// <para>
    /// Em <c>OnAfterRenderAsync</c> e não em <c>OnInitializedAsync</c> porque o <c>@ref</c>
    /// da grade só existe depois do primeiro render; e o método não roda no prerender, então
    /// a carga acontece uma vez, no circuito interativo.
    /// </para>
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _grid is not null)
        {
            await CarregarFiltrosAsync();
            await _grid.Reload();
        }
    }

    private async Task LoadData(LoadDataArgs args)
    {
        _loading = true;
        try
        {
            // args.OrderBy chega como "Coluna asc" / "Coluna desc" (uma por vez). O nome
            // sai daqui para a whitelist do servidor, que decide se ele vale.
            string? orderBy = null;
            var desc = true;
            if (!string.IsNullOrWhiteSpace(args.OrderBy))
            {
                var partes = args.OrderBy.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                orderBy = partes[0];
                desc = partes.Length > 1 && partes[1].Equals("desc", StringComparison.OrdinalIgnoreCase);
            }

            var pagina = await ComparacoesApi.GetItensAsync(
                SessaoId, args.Skip ?? 0, args.Top ?? 25, orderBy, desc, _filtro);

            _itens = pagina.Itens;
            // "Nenhum item com dado de mercado" só significa algo quando há itens: página
            // vazia por filtro não é ausência de mercado.
            _semMercadoNenhum = _itens.Count > 0 && !_itens.Any(i => i.TemDadoDeMercado);
            _total = pagina.Total;
            _totalSemFiltro = pagina.TotalSemFiltro;
            _totais = pagina.Totais;
            _erro = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao buscar itens da sessao {SessaoId}", SessaoId);
            _itens = [];
            _erro = ErroDeLeituraParaOComprador;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Unidades(decimal valor) => valor.ToString("N0");

    /// <summary>
    /// Tooltip da célula do índice: as unidades que produziram o número, e o mês e bairro que
    /// foram comparados. Vive no title da célula para a tabela não ganhar quatro colunas —
    /// mas o comprador precisa poder auditar o índice sem abrir a planilha.
    /// </summary>
    /// <summary>
    /// Frase por alerta, no title da célula. Cada uma diz o que o sistema verificou e o que
    /// NÃO verificou — sem isso "sem causa aparente" lê como "já conferi tudo", e preço nunca
    /// foi conferido porque a fonte não traz preço de concorrente.
    /// </summary>
    /// <summary>
    /// Quantos itens do recorte têm medição de mercado, e sobre quantos. Nulo quando ainda
    /// não há totais carregados ou o recorte está vazio — aí não há o que declarar.
    /// </summary>
    private (int Com, int Total)? CoberturaDeMercado =>
        _totais is { Itens: > 0 } t ? (t.ItensComDadoDeMercado, t.Itens) : null;

    private const string AjudaDoMes =
        "Nunca o mês da própria sugestão: aquele mês já contém o efeito desta compra, e usá-lo faria o alerta descrever a própria decisão em vez de antecipá-la. A regra é sempre o último mês carregado ANTES do mês da sugestão — com um relatório só carregado, isso cai no mesmo mês do ano anterior, que é sazonalmente comparável.";

    private const string AjudaDaCobertura =
        "Falta de medição significa uma de três coisas: a loja não tem CNPJ no arquivo enviado (versões antigas do extrator não trazem), o produto não tem código de barras no cadastro do PBS, ou a IQVIA não reportou venda dele naqueles bairros — o que por si já é informação: o mercado local não move o item.";

    private const string AjudaDoPreco =
        "O relatório da IQVIA não informa o preço praticado por cada concorrente: ele publica um preço de referência igual para a rede e para a concorrência. Medimos isso — em 37.410 comparações, zero diferença. Então preço não pode ser testado, e a hipótese de preço ficou fora do alerta em vez de virar um número que não significa o que promete.";

    private static string ExplicacaoDoAlerta(SessaoItem i) => i.MercadoAlerta switch
    {
        "Ruptura" =>
            $"Vendemos abaixo do nosso normal neste bairro E ficamos {i.MercadoDiasSemEstoque} dia(s) "
            + "sem estoque no mês comparado. A falta de produto é a explicação mais provável. "
            + "Preço não foi verificado: a IQVIA não informa o preço dos concorrentes.",
        "SemCausa" =>
            "Vendemos abaixo do nosso normal neste bairro e havia estoque todos os dias do mês "
            + "comparado — falta de produto NÃO explica. Preço não foi verificado: a IQVIA não "
            + "informa o preço dos concorrentes. Vale olhar exposição, mix de apresentação e "
            + "concorrente novo no bairro.",
        "NaoApurado" =>
            "Vendemos abaixo do nosso normal neste bairro, mas o mês comparado não veio no "
            + "histórico de estoque do arquivo enviado — então NÃO se sabe se faltou produto. "
            + "Não é o mesmo que \"não houve ruptura\".",
        _ => "",
    };

    private static string DetalheDoMercado(SessaoItem i)
    {
        var mes = i.MercadoMes is { } m ? m.ToString("MM/yyyy") : "?";
        var nossas = i.MercadoUnidadesRede is { } r ? Unidades(r) : "?";
        var deles = i.MercadoUnidadesConcorrentes is { } c ? Unidades(c) : "?";
        return $"{i.MercadoBrick} em {mes}: nós {nossas} un., concorrentes {deles} un.";
    }

    /// <summary>
    /// Nenhum item da página tem dado de mercado. Não é o mesmo que "a rede vai bem": é uma
    /// das pontes não fechando para o envio inteiro, e o aviso acima da tabela diz qual.
    /// </summary>
    private bool _semMercadoNenhum;

    /// <summary>Mês da IQVIA que esta sessão comparou, do primeiro item que o declara.</summary>
    private DateOnly? MesDeMercado => _itens.FirstOrDefault(i => i.MercadoMes is not null)?.MercadoMes;

    /// <summary>
    /// Texto de cadastro ausente. Travessao, e nao vazio: celula em branco parece falha de
    /// renderizacao, e o comprador precisa saber que o dado nao existe no cadastro dele.
    /// </summary>
    /// <summary>
    /// Traduz o estado da análise rápida para cor, rótulo e explicação. <b>Cinza não é uma cor
    /// mais fraca que o vermelho</b> — é outro problema: o vermelho diz "sobrou demais para o
    /// giro", o cinza diz "não há giro nenhum", e o segundo costuma ser pior.
    /// </summary>
    private static (string Cor, string Rotulo, string Titulo)? SinalDaAnalise(string? estado) => estado switch
    {
        "Vermelho" => ("var(--rz-danger)", "encalhado", "60 dias de cobertura ou mais."),
        "Amarelo" => ("var(--rz-warning)", "atenção", "Entre 30 e 59 dias de cobertura."),
        "Verde" => ("var(--rz-success)", "ok", "Menos de 30 dias de cobertura."),
        "SemGiro" => ("var(--rz-text-tertiary-color)", "sem giro",
            "Tem estoque parado e não vendeu nada nos últimos 120 dias. Não há cobertura a calcular."),
        _ => null,
    };

    /// <summary>
    /// Fecha a conta do placar em palavras. Declara os empates e, sobretudo, os itens
    /// <b>sem preço comparável</b> — sem essa frase os dois números do placar somariam menos que
    /// os itens medidos e ninguém saberia por quê.
    /// </summary>
    private static string PlacarDePrecoNota(TotaisDosItens t)
    {
        var partes = new List<string> { $"sobre {t.ItensComPrecoComparavel:N0} com preço nos dois lados" };

        if (t.ItensComPrecoEmpatado > 0) partes.Add($"{t.ItensComPrecoEmpatado:N0} igual(is)");

        if (t.ItensSemPrecoComparavel > 0)
        {
            partes.Add($"{t.ItensSemPrecoComparavel:N0} sem preço da rede");
        }

        return string.Join(" · ", partes);
    }

    private const string AjudaDoPlacarDePreco =
        "Preço médio de cada lado no bairro e mês comparados: o valor que a IQVIA reporta dividido " +
        "pelas unidades que ela reporta. ATENÇÃO: a IQVIA normaliza preços entre os participantes " +
        "do painel, então estes NÃO são preços de balcão — são índices. Comparar um com o outro é " +
        "legítimo porque saem do mesmo arquivo e da mesma normalização; comparar qualquer um deles " +
        "com o seu preço de compra, ou com a sua base de vendas, mede metodologia e não preço. " +
        "Os itens “sem preço da rede” são aqueles em que a rede não vendeu nenhuma unidade no " +
        "recorte: sem venda não há preço, e eles não entram em nenhum dos dois lados.";

    private static string Texto(string? valor) =>
        string.IsNullOrWhiteSpace(valor) ? "—" : valor;

    /// <summary>
    /// Unidades, ou travessao quando nao ha medida. <b>Nunca zero para ausencia:</b> nestas
    /// colunas zero e uma medicao — prateleira vazia —, e trocar uma coisa pela outra inverte
    /// a leitura da linha.
    /// </summary>
    private static string UnidadesOuTraco(decimal? valor) =>
        valor is { } v ? Unidades(v) : "—";

    private static string UnidadesOuSemMl(decimal? valor) =>
        valor is { } v ? Unidades(v) : SemCalculoDoMl;

    private static string Dinheiro(decimal? valor) =>
        valor is { } v ? v.ToString("C2") : SemCalculoDoMl;

    /// <summary>
    /// Diferença com sinal explícito: "+294" e "−12" dizem qual braço encalhou mais sem exigir
    /// que o leitor compare as duas colunas de cabeça.
    /// </summary>
    private static string DiferencaUnidades(decimal? valor) =>
        valor is { } v ? (v > 0 ? "+" : "") + Unidades(v) : SemCalculoDoMl;

    private static string ApuradoSobre(int itens) => $"sobre {itens:N0} item(ns) com cálculo do ML";

    private const string TipComparavel =
        "O braço de ML não alcança todos os itens da sugestão (cobertura além do horizonte, série " +
        "incompleta, SKU fora do orçamento do treino). Comparar a soma dele com o total do PBS " +
        "mediria essa diferença de população, e não a qualidade dos dois métodos — por isso os dois " +
        "lados desta faixa somam exatamente os mesmos itens.";

    /// <summary>
    /// Quantos itens sustentam a faixa comparável. Sai da contagem de sobra, e não da de
    /// compra: é a sobra que alimenta a diferença exibida ao lado.
    /// </summary>
    private static int ItensComparaveis(TotaisDosItens t) =>
        t.ItensComSobraMl > 0 ? t.ItensComSobraMl : t.ItensComCompraMl;

    /// <summary>
    /// Nota da coluna em reais <b>do PBS</b>. Aqui o valor é nulo por um motivo só — o item não
    /// tem preço de compra cadastrado —, então nomear essa causa é correto. Só aparece quando
    /// falta preço em algum item: um aviso permanente viraria ruído.
    /// </summary>
    private static string? SemPrecoDeCompra(int comPreco, int itens) =>
        comPreco >= itens ? null : $"{itens - comPreco:N0} item(ns) sem preço de compra ficaram fora";

    /// <summary>
    /// Nota da coluna em reais <b>do ML</b>, e ela não pode copiar a do PBS.
    ///
    /// <para>
    /// O valor do ML é nulo por <b>duas</b> causas diferentes: o item não teve cálculo de ML, ou
    /// não tem preço de compra. Atribuir tudo a "sem preço" — como esta nota fazia — é
    /// misattribuição visível: na sugestão 125595, dos 18.047 itens fora da soma praticamente
    /// todos faltam por não ter cálculo de ML, e nenhum por falta de preço. A nota diz sobre
    /// quantos a soma foi apurada, e só acusa preço quando ele de fato tira item que <b>tinha</b>
    /// cálculo de ML.
    /// </para>
    /// </summary>
    private static string ApuradoSobreValorMl(TotaisDosItens t)
    {
        var perdidosPorPreco = t.ItensComSobraMl - t.ItensComValorMl;
        var basico = $"sobre {t.ItensComValorMl:N0} item(ns) com cálculo do ML";
        return perdidosPorPreco > 0
            ? $"{basico} — {perdidosPorPreco:N0} ficaram fora por não ter preço de compra"
            : basico;
    }
}
