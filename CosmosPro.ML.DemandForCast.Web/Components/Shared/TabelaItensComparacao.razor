@* Detalhe item a item. Paginação e ordenação são do SERVIDOR: a população é a da sugestão
   inteira do ERP e o comprador ordena a tabela para achar o pior item.

   Nenhuma célula do braço de ML pode virar traço ou zero quando o valor é nulo: nulo é
   "não foi possível calcular" e zero é "o ML mandaria não comprar nada". *@
@inject ComparacoesApiClient ComparacoesApi
@inject NavigationManager Nav
@inject ILogger<TabelaItensComparacao> Logger

<RadzenStack Gap="0.75rem">
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.Subtitle1" Style="margin: 0">Item por item</RadzenText>
        <RadzenBadge Text="@ContagemDoRecorte" BadgeStyle="@(_filtro.Algum ? BadgeStyle.Info : BadgeStyle.Light)" IsPill="true" />
        <HelpTip Text="Cada página é buscada no servidor sob demanda, e clicar num cabeçalho refaz a consulta ordenada no banco. Ordene por 'Sobrou' para achar o que mais encalhou." />
        <div style="flex: 1"></div>
        <RadzenButton Click="@ExportarExcel" Icon="table_view" Text="Exportar para Excel"
                      ButtonStyle="ButtonStyle.Primary" Variant="Variant.Outlined" Size="ButtonSize.Small"
                      Disabled="@(_total == 0)" data-test="exportar-itens-excel" />
        <HelpTip Text="Baixa uma planilha .xlsx com EXATAMENTE os itens que os filtros acima selecionaram — não a sugestão inteira. O arquivo traz uma aba de capa dizendo quais filtros estavam aplicados e sobre quantos itens cada total foi apurado, para duas exportações diferentes não ficarem indistinguíveis no seu computador. Onde o ML não pôde ser calculado a célula traz um texto, nunca zero: o Excel se recusa a somá-lo, que é o comportamento correto." />
    </RadzenStack>

    @* --- Filtros combináveis ------------------------------------------------------- *@
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
        <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0">Filtros</RadzenText>
        <HelpTip Text="Os filtros são combináveis: escolher Loja 18 e Curva A mostra só os itens que atendem às duas condições ao mesmo tempo. Servem para descobrir onde as diferenças entre PBS e ML se concentram. Departamento não está disponível porque o ERP não exporta esse campo hoje — a extração traz Categoria, e inventar departamento a partir dela seria dado fabricado numa tela de decisão de compra." />

        <RadzenFormField Text="Loja" Variant="Variant.Outlined" Style="width: 140px">
            <RadzenDropDown TValue="int?" Value="@_filtro.LojaId" Data="@_lojas" AllowClear="true"
                            Placeholder="todas" Change="@(v => AplicarAsync(_filtro with { LojaId = (int?)v }))" />
        </RadzenFormField>

        @if (_categoriasDisponiveis.Count > 0)
        {
            <RadzenFormField Text="Categoria" Variant="Variant.Outlined" Style="width: 230px">
                <RadzenDropDown TValue="string" Value="@_filtro.Categoria" Data="@_categoriasDisponiveis"
                                TextProperty="Rotulo" ValueProperty="Valor" AllowClear="true"
                                Placeholder="todas" Change="@(v => AplicarAsync(_filtro with { Categoria = (string?)v }))" />
            </RadzenFormField>
        }

        @if (_curvasDisponiveis.Count > 0)
        {
            <RadzenFormField Text="Curva do ERP" Variant="Variant.Outlined" Style="width: 160px">
                <RadzenDropDown TValue="string" Value="@_filtro.Curva" Data="@_curvasDisponiveis"
                                TextProperty="Rotulo" ValueProperty="Valor" AllowClear="true"
                                Placeholder="todas" Change="@(v => AplicarAsync(_filtro with { Curva = (string?)v }))" />
            </RadzenFormField>
        }

        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.35rem">
            @* O data-test vive num <span> puro, e nao no RadzenCheckBox: componente Radzen
               nao repassa atributo desconhecido para o DOM, e o seletor do E2E nao acharia
               nada -- falha por timeout, sem dizer o motivo. *@
            <span data-test="filtro-somente-com-alerta">
                <RadzenCheckBox TValue="bool" Value="@_filtro.SomenteComAlerta" Name="somenteComAlerta"
                                Change="@(v => AplicarAsync(_filtro with { SomenteComAlerta = (bool)v }))" />
            </span>
            <RadzenLabel Text="Só com alerta de mercado" Component="somenteComAlerta" Style="cursor: pointer" />
            <HelpTip Text="Mostra só os itens em que a rede vendeu abaixo do que costuma vender naquele bairro, segundo a IQVIA. Item sem dado de mercado NÃO entra neste recorte: ausência de medição não é alerta, e tratá-la como alerta encheria a lista de itens que ninguém mediu." />
        </RadzenStack>

        @if (_filtro.Algum)
        {
            <RadzenButton Click="@(() => AplicarAsync(FiltroDeItens.Nenhum))" Icon="filter_alt_off"
                          Text="Limpar filtros" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                          Size="ButtonSize.Small" data-test="limpar-filtros-itens" />
        }
    </RadzenStack>

    @if (_semCategoriaNenhuma)
    {
        @* Categoria é gravada na materialização (o Stage é apagado no import seguinte), então
           comparação executada antes dessa coluna existir não tem o dado. Dizer isso é
           diferente de exibir um filtro vazio, que passaria por defeito. *@
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false">
            <strong>Esta comparação não tem categoria nos itens.</strong>
            <div style="margin-top: 0.35rem">
                A categoria é gravada quando a comparação é processada, e esta rodou antes de o campo
                existir. Rode uma comparação nova, com o mesmo arquivo, para poder filtrar por categoria.
            </div>
        </RadzenAlert>
    }

    @if (_semMercadoNenhum)
    {
        @* Sem este aviso, o comprador vê três colunas novas com travessão em toda linha e
           conclui que o alerta de mercado não funciona. O que falta é sempre uma das duas
           pontes, e as duas têm conserto diferente. *@
        <RadzenAlert AlertStyle="AlertStyle.Info" Variant="Variant.Flat" Shade="Shade.Lighter"
                     AllowClose="false" data-test="aviso-sem-mercado">
            <strong>Nenhum item desta comparação tem dado de mercado da IQVIA.</strong>
            <div style="margin-top: 0.35rem">
                Isso acontece quando falta uma das duas ligações. <strong>Loja → bairro:</strong> o
                arquivo enviado precisa vir de um extrator que traga o CNPJ das lojas — versões
                antigas não trazem, e sem CNPJ nenhuma loja se liga a um bairro da IQVIA.
                <strong>Produto → código de barras:</strong> o produto precisa ter EAN no cadastro do
                PBS, e a IQVIA precisa ter reportado venda dele naqueles bairros.
                Confira também, na tela <a href="/mercado">Dados de mercado</a>, se existe um mês
                carregado <em>anterior</em> ao mês desta sugestão — a comparação nunca usa o mês da
                própria sugestão.
            </div>
        </RadzenAlert>
    }

    @if (MesDeMercado is { } mesMercado)
    {
        <RadzenText TextStyle="TextStyle.Caption" Style="color: var(--rz-text-tertiary-color)">
            Colunas de mercado comparadas contra <strong>@mesMercado.ToString("MM/yyyy")</strong> da
            IQVIA — o último mês carregado antes do mês desta sugestão.
        </RadzenText>
    }

    @* --- Totalizadores do recorte -------------------------------------------------- *@
    @if (_totais is { } t)
    {
        <RadzenCard Variant="Variant.Filled" data-test="totalizadores-itens">
            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.5rem" Wrap="FlexWrap.Wrap">
                <RadzenText TextStyle="TextStyle.Subtitle2" Style="margin: 0">Totais do recorte</RadzenText>
                <HelpTip Text="Somam apenas os itens que os filtros selecionaram, e são recalculados no servidor a cada mudança de filtro. As somas do lado do ML falam só dos itens em que ele pôde ser calculado — o número aparece abaixo de cada uma. Onde o ML não tem cálculo o total aparece como 'sem cálculo do ML' e nunca como zero: zero afirmaria que o ML mandaria não comprar nada, que é o contrário de não haver conta." />
            </RadzenStack>

            <RadzenStack Orientation="Orientation.Horizontal" Gap="2rem" Wrap="FlexWrap.Wrap" class="rz-mt-2">
                <Totalizador Rotulo="Itens analisados" Valor="@($"{t.Itens:N0}")" />
                <Totalizador Rotulo="Compra PBS (un.)" Valor="@Unidades(t.CompraPbsUnidades)" />
                <Totalizador Rotulo="Compra ML (un.)" Valor="@UnidadesOuSemMl(t.CompraMlUnidades)"
                             Nota="@ApuradoSobre(t.ItensComCompraMl)" />
                <Totalizador Rotulo="Sobra PBS (un.)" Valor="@Unidades(t.SobraPbsUnidades)" />
                <Totalizador Rotulo="Sobra ML (un.)" Valor="@UnidadesOuSemMl(t.SobraMlUnidades)"
                             Nota="@ApuradoSobre(t.ItensComSobraMl)" />
                <Totalizador Rotulo="Diferença de sobra (un.)" Valor="@DiferencaUnidades(t.DiferencaSobraUnidades)" />
                <Totalizador Rotulo="R$ parado PBS" Valor="@Dinheiro(t.SobraPbsValor)"
                             Nota="@SemPrecoDeCompra(t.ItensComValorPbs, t.Itens)" />
                <Totalizador Rotulo="R$ parado ML" Valor="@Dinheiro(t.SobraMlValor)"
                             Nota="@ApuradoSobreValorMl(t)" />
            </RadzenStack>
        </RadzenCard>
    }

    <RadzenText TextStyle="TextStyle.Body2" Style="margin: 0; color: var(--rz-text-secondary-color)">
        "Sobrou" é o que restou na prateleira no fim do período que a compra deveria cobrir: o que foi
        comprado, mais o que já havia em estoque e o que estava a caminho, menos o que a loja vendeu.
    </RadzenText>

    @if (_erro is not null)
    {
        @* Falha de leitura não pode virar "nenhum item": o EmptyText da grade afirma que a
           comparação não deixou item nenhum, e aqui o que faltou foi a resposta. *@
        <RadzenAlert AlertStyle="AlertStyle.Danger" AllowClose="false">
            <strong>Não foi possível carregar os itens desta comparação.</strong>
            <div style="margin-top: 0.35rem">@_erro</div>
        </RadzenAlert>
    }

    <div data-test="tabela-itens">

    <RadzenDataGrid @ref="_grid" TItem="SessaoItem"
                    Data="@_itens" Count="@_total" LoadData="@LoadData"
                    AllowPaging="true" PageSize="25"
                    AllowSorting="true"
                    IsLoading="@_loading"
                    Density="Density.Compact"
                    PagerHorizontalAlign="HorizontalAlign.Center"
                    EmptyText="Esta comparação não deixou nenhum item para detalhar.">
        <Columns>
            <RadzenDataGridColumn TItem="SessaoItem" Property="Sku" Title="Código" Width="120px" />
            <RadzenDataGridColumn TItem="SessaoItem" Property="NomeProduto" Title="Produto" Width="220px">
                <Template Context="i">
                    @if (string.IsNullOrWhiteSpace(i.NomeProduto))
                    {
                        <span style="color: var(--rz-warning)">sem cadastro no ERP</span>
                    }
                    else
                    {
                        @i.NomeProduto
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="LojaId" Title="Loja" Width="90px" TextAlign="TextAlign.Right" />
            <RadzenDataGridColumn TItem="SessaoItem" Property="Curva" Title="Curva" Width="90px">
                <Template Context="i">@(string.IsNullOrWhiteSpace(i.Curva) ? "sem curva" : i.Curva)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="Categoria" Title="Categoria" Width="150px" Sortable="false">
                <HeaderTemplate>
                    <span>Categoria</span>
                    <HelpTip Text="Categoria do produto no cadastro do PBS, copiada quando a comparação foi processada. Comparações antigas não têm o dado. Departamento não aparece porque o ERP não exporta esse campo." Size="0.85rem" />
                </HeaderTemplate>
                <Template Context="i">
                    @if (string.IsNullOrWhiteSpace(i.Categoria))
                    {
                        <span style="color: var(--rz-text-tertiary-color)">sem categoria</span>
                    }
                    else
                    {
                        @i.Categoria
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="CompraSugeridaPbs" Title="Comprado (PBS)" Width="140px" TextAlign="TextAlign.Right">
                <Template Context="i">@Unidades(i.CompraSugeridaPbs)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="CompraSugeridaMl" Title="Compraria (ML)" Width="150px" TextAlign="TextAlign.Right">
                <Template Context="i">
                    @if (i.CompraSugeridaMl is { } ml)
                    {
                        @Unidades(ml)
                    }
                    else
                    {
                        <span style="color: var(--rz-text-tertiary-color)">@SemCalculoDoMl</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="VendidoNaJanela" Title="Vendido no período" Width="150px" TextAlign="TextAlign.Right">
                <Template Context="i">@Unidades(i.VendidoNaJanela)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="SobraPbsUnidades" Title="Sobrou (PBS)" Width="130px" TextAlign="TextAlign.Right">
                <Template Context="i">@Unidades(i.SobraPbsUnidades)</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="SobraMlUnidades" Title="Sobraria (ML)" Width="140px" TextAlign="TextAlign.Right">
                <Template Context="i">
                    @if (i.SobraMlUnidades is { } ml)
                    {
                        @Unidades(ml)
                    }
                    else
                    {
                        <span style="color: var(--rz-text-tertiary-color)">@SemCalculoDoMl</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="SobraPbsValor" Title="Dinheiro parado" Width="150px" TextAlign="TextAlign.Right">
                <Template Context="i">
                    @if (i.SobraPbsValor is { } valor)
                    {
                        @($"R$ {valor.ToString("N2")}")
                    }
                    else
                    {
                        <span style="color: var(--rz-warning)">sem preço de compra</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Title="Quem ficou mais perto" Width="180px" Sortable="false">
                <Template Context="i">
                    @if (i.MlFicouMaisPerto is null)
                    {
                        <RadzenBadge Text="só o PBS foi calculado" BadgeStyle="BadgeStyle.Light" Shade="Shade.Lighter" IsPill="true" />
                    }
                    else if (i.Empate)
                    {
                        <RadzenBadge Text="empate" BadgeStyle="BadgeStyle.Light" Shade="Shade.Lighter" IsPill="true" />
                    }
                    else if (i.MlFicouMaisPerto is true)
                    {
                        <RadzenBadge Text="ML ficou mais perto" BadgeStyle="BadgeStyle.Success" Shade="Shade.Lighter" IsPill="true" />
                    }
                    else
                    {
                        <RadzenBadge Text="PBS ficou mais perto" BadgeStyle="BadgeStyle.Info" Shade="Shade.Lighter" IsPill="true" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="JanelaAlemDoHistorico" Title="Ressalva" Width="170px">
                <Template Context="i">
                    @if (i.JanelaAlemDoHistorico)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenIcon Icon="warning" Style="color: var(--rz-warning); font-size: 1rem" />
                            <span style="color: var(--rz-warning)">período incompleto</span>
                            <HelpTip Size="0.85rem" Text="O período que esta compra deveria cobrir termina depois do último dia de venda que veio no arquivo. A venda deste item sai contada por menos e a sobra, por mais: não compare esta linha com as outras." />
                        </RadzenStack>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="MercadoIndiceDesempenho"
                                  Title="Índice vs bairro" Width="150px" TextAlign="TextAlign.Right">
                <HeaderTemplate>
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                        <span>Índice vs bairro</span>
                        <HelpTip Text="Quanto este item captura no bairro, comparado com o que a rede captura ali em média. 1,00 = igual ao normal da rede. 0,50 = metade. Abaixo de 0,50 acende alerta. Não é fatia de mercado: o tamanho da rede no bairro está nos dois lados da conta e se cancela, então o que sobra é o desempenho do produto." />
                    </RadzenStack>
                </HeaderTemplate>
                <Template Context="i">
                    @if (i.MercadoIndiceDesempenho is { } ix)
                    {
                        <span title="@DetalheDoMercado(i)"
                              style="@(ix < 0.5m ? "color: var(--rz-danger); font-weight: 600" : null)">
                            @ix.ToString("N2")
                        </span>
                    }
                    else
                    {
                        @* Travessão e nunca zero: zero diria que o item não vende no bairro, o
                           que é uma medição, e ninguém a fez. *@
                        <span style="color: var(--rz-text-tertiary-color)" title="Sem dado de mercado para este item">—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="MercadoDiasSemEstoque"
                                  Title="Dias sem estoque" Width="140px" TextAlign="TextAlign.Right">
                <Template Context="i">
                    @if (i.MercadoDiasSemEstoque is { } d)
                    {
                        <span>@d</span>
                    }
                    else
                    {
                        <span style="color: var(--rz-text-tertiary-color)">—</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="SessaoItem" Property="MercadoAlerta"
                                  Title="Alerta de mercado" Width="230px">
                <Template Context="i">
                    @if (i.AlertaDeMercadoLegivel is { } rotulo)
                    {
                        <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Gap="0.25rem">
                            <RadzenIcon Icon="trending_down" Style="color: var(--rz-danger); font-size: 1rem" />
                            <span style="color: var(--rz-danger)">@rotulo</span>
                        </RadzenStack>
                    }
                    else if (i.TemDadoDeMercado)
                    {
                        <span style="color: var(--rz-text-tertiary-color)">dentro do esperado</span>
                    }
                    else
                    {
                        @* "Sem dado" e "dentro do esperado" são afirmações diferentes, e a
                           coluna precisa distingui-las: o comprador não pode ler ausência de
                           medição como aprovação. *@
                        <span style="color: var(--rz-text-tertiary-color)" title="Uma das pontes não fechou: loja sem CNPJ, produto sem código de barras, ou a IQVIA não reportou este item no bairro.">sem dado</span>
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
    </div>
</RadzenStack>

@code {
    [Parameter, EditorRequired] public Guid SessaoId { get; set; }

    /// <summary>
    /// Texto no lugar do número quando o braço de ML não existe para a linha. Traço ou zero
    /// aqui leriam como "o ML concordou" e "o ML mandaria não comprar nada" — as duas coisas
    /// que ninguém calculou.
    /// </summary>
    private const string SemCalculoDoMl = "sem cálculo do ML";

    /// <summary>
    /// Texto para o comprador no lugar de <c>ex.Message</c> — a mensagem técnica ("Response
    /// status code does not indicate success…") não diz nada a quem não programa, e vai só
    /// para o log.
    /// </summary>
    private const string ErroDeLeituraParaOComprador =
        "Não deu para buscar esta página de itens agora. Tente novamente em alguns instantes; " +
        "se continuar acontecendo, procure o suporte.";

    private RadzenDataGrid<SessaoItem> _grid = null!;
    private IReadOnlyList<SessaoItem> _itens = [];
    private int _total;
    private int _totalSemFiltro;
    private bool _loading;
    private string? _erro;

    private FiltroDeItens _filtro = FiltroDeItens.Nenhum;
    private TotaisDosItens? _totais;
    private IReadOnlyList<int> _lojas = [];
    private IReadOnlyList<OpcaoDeFiltro> _categoriasDisponiveis = [];
    private IReadOnlyList<OpcaoDeFiltro> _curvasDisponiveis = [];
    private bool _semCategoriaNenhuma;

    /// <summary>
    /// Uma opção de dropdown. <c>Valor</c> pode ser o sentinela de ausência, e é por isso que
    /// rótulo e valor são campos separados: "sem categoria" precisa aparecer legível na tela e
    /// viajar como <c>FiltroDeItens.Ausente</c> na consulta.
    /// </summary>
    private sealed record OpcaoDeFiltro(string Valor, string Rotulo);

    /// <summary>
    /// "12 de 20.153 itens" quando há filtro; só o total quando não há. O denominador é o que
    /// diz ao comprador se ele está olhando um recorte ou a sugestão inteira.
    /// </summary>
    private string ContagemDoRecorte => _filtro.Algum
        ? $"{_total:N0} de {_totalSemFiltro:N0} itens"
        : $"{_total:N0} itens";

    private async Task AplicarAsync(FiltroDeItens novo)
    {
        _filtro = novo;
        // Volta para a primeira página: manter a página 7 depois de filtrar para 12 itens
        // renderizaria uma tabela vazia com paginador dizendo que há dados.
        if (_grid is not null)
        {
            await _grid.FirstPage(true);
        }
    }

    private void ExportarExcel()
    {
        // forceLoad: é um endpoint HTTP comum, não rota Blazor. Sem isso o router tentaria
        // resolvê-la no circuito e cairia em "página não encontrada".
        Nav.NavigateTo($"/comparacoes/{SessaoId}/itens/excel{QueryDoFiltro()}", forceLoad: true);
    }

    private string QueryDoFiltro()
    {
        var q = new List<string>();
        if (_filtro.LojaId is { } loja) q.Add($"lojaId={loja}");
        if (!string.IsNullOrWhiteSpace(_filtro.Categoria)) q.Add($"categoria={Uri.EscapeDataString(_filtro.Categoria)}");
        if (!string.IsNullOrWhiteSpace(_filtro.Curva)) q.Add($"curva={Uri.EscapeDataString(_filtro.Curva)}");
        return q.Count == 0 ? "" : "?" + string.Join("&", q);
    }

    private async Task CarregarFiltrosAsync()
    {
        try
        {
            var d = await ComparacoesApi.GetFiltrosDeItensAsync(SessaoId);
            if (d is null) return;

            _lojas = d.Lojas;
            _categoriasDisponiveis =
            [
                .. d.Categorias.Select(c => new OpcaoDeFiltro(c, c)),
                .. d.TemItemSemCategoria && d.Categorias.Count > 0
                    ? new[] { new OpcaoDeFiltro(FiltroDeItens.Ausente, "sem categoria") }
                    : [],
            ];
            _curvasDisponiveis =
            [
                .. d.Curvas.Select(c => new OpcaoDeFiltro(c, c)),
                .. d.TemItemSemCurva && d.Curvas.Count > 0
                    ? new[] { new OpcaoDeFiltro(FiltroDeItens.Ausente, "sem curva") }
                    : [],
            ];
            _semCategoriaNenhuma = d.TemItemSemCategoria && d.Categorias.Count == 0;
        }
        catch (Exception ex)
        {
            // Falha aqui não pode derrubar a tabela: sem as opções o comprador perde os
            // filtros, não os itens.
            Logger.LogError(ex, "Falha ao buscar filtros da sessao {SessaoId}", SessaoId);
        }
    }

    /// <summary>
    /// Dispara a primeira página à mão. A grade só chama <c>LoadData</c> sozinha quando
    /// <c>Data</c> chega nula, e aqui ela chega numa lista vazia — sem este
    /// <c>Reload</c> a tabela renderizava o <c>EmptyText</c> ("não deixou nenhum item")
    /// sem nunca ter perguntado ao servidor, que é a mentira mais barata desta tela.
    ///
    /// <para>
    /// Em <c>OnAfterRenderAsync</c> e não em <c>OnInitializedAsync</c> porque o <c>@ref</c>
    /// da grade só existe depois do primeiro render; e o método não roda no prerender, então
    /// a carga acontece uma vez, no circuito interativo.
    /// </para>
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _grid is not null)
        {
            await CarregarFiltrosAsync();
            await _grid.Reload();
        }
    }

    private async Task LoadData(LoadDataArgs args)
    {
        _loading = true;
        try
        {
            // args.OrderBy chega como "Coluna asc" / "Coluna desc" (uma por vez). O nome
            // sai daqui para a whitelist do servidor, que decide se ele vale.
            string? orderBy = null;
            var desc = true;
            if (!string.IsNullOrWhiteSpace(args.OrderBy))
            {
                var partes = args.OrderBy.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                orderBy = partes[0];
                desc = partes.Length > 1 && partes[1].Equals("desc", StringComparison.OrdinalIgnoreCase);
            }

            var pagina = await ComparacoesApi.GetItensAsync(
                SessaoId, args.Skip ?? 0, args.Top ?? 25, orderBy, desc, _filtro);

            _itens = pagina.Itens;
            // "Nenhum item com dado de mercado" só significa algo quando há itens: página
            // vazia por filtro não é ausência de mercado.
            _semMercadoNenhum = _itens.Count > 0 && !_itens.Any(i => i.TemDadoDeMercado);
            _total = pagina.Total;
            _totalSemFiltro = pagina.TotalSemFiltro;
            _totais = pagina.Totais;
            _erro = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Falha ao buscar itens da sessao {SessaoId}", SessaoId);
            _itens = [];
            _erro = ErroDeLeituraParaOComprador;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Unidades(decimal valor) => valor.ToString("N0");

    /// <summary>
    /// Tooltip da célula do índice: as unidades que produziram o número, e o mês e bairro que
    /// foram comparados. Vive no title da célula para a tabela não ganhar quatro colunas —
    /// mas o comprador precisa poder auditar o índice sem abrir a planilha.
    /// </summary>
    private static string DetalheDoMercado(SessaoItem i)
    {
        var mes = i.MercadoMes is { } m ? m.ToString("MM/yyyy") : "?";
        var nossas = i.MercadoUnidadesRede is { } r ? Unidades(r) : "?";
        var deles = i.MercadoUnidadesConcorrentes is { } c ? Unidades(c) : "?";
        return $"{i.MercadoBrick} em {mes}: nós {nossas} un., concorrentes {deles} un.";
    }

    /// <summary>
    /// Nenhum item da página tem dado de mercado. Não é o mesmo que "a rede vai bem": é uma
    /// das pontes não fechando para o envio inteiro, e o aviso acima da tabela diz qual.
    /// </summary>
    private bool _semMercadoNenhum;

    /// <summary>Mês da IQVIA que esta sessão comparou, do primeiro item que o declara.</summary>
    private DateOnly? MesDeMercado => _itens.FirstOrDefault(i => i.MercadoMes is not null)?.MercadoMes;

    private static string UnidadesOuSemMl(decimal? valor) =>
        valor is { } v ? Unidades(v) : SemCalculoDoMl;

    private static string Dinheiro(decimal? valor) =>
        valor is { } v ? v.ToString("C2") : SemCalculoDoMl;

    /// <summary>
    /// Diferença com sinal explícito: "+294" e "−12" dizem qual braço encalhou mais sem exigir
    /// que o leitor compare as duas colunas de cabeça.
    /// </summary>
    private static string DiferencaUnidades(decimal? valor) =>
        valor is { } v ? (v > 0 ? "+" : "") + Unidades(v) : SemCalculoDoMl;

    private static string ApuradoSobre(int itens) => $"sobre {itens:N0} item(ns) com cálculo do ML";

    /// <summary>
    /// Nota da coluna em reais <b>do PBS</b>. Aqui o valor é nulo por um motivo só — o item não
    /// tem preço de compra cadastrado —, então nomear essa causa é correto. Só aparece quando
    /// falta preço em algum item: um aviso permanente viraria ruído.
    /// </summary>
    private static string? SemPrecoDeCompra(int comPreco, int itens) =>
        comPreco >= itens ? null : $"{itens - comPreco:N0} item(ns) sem preço de compra ficaram fora";

    /// <summary>
    /// Nota da coluna em reais <b>do ML</b>, e ela não pode copiar a do PBS.
    ///
    /// <para>
    /// O valor do ML é nulo por <b>duas</b> causas diferentes: o item não teve cálculo de ML, ou
    /// não tem preço de compra. Atribuir tudo a "sem preço" — como esta nota fazia — é
    /// misattribuição visível: na sugestão 125595, dos 18.047 itens fora da soma praticamente
    /// todos faltam por não ter cálculo de ML, e nenhum por falta de preço. A nota diz sobre
    /// quantos a soma foi apurada, e só acusa preço quando ele de fato tira item que <b>tinha</b>
    /// cálculo de ML.
    /// </para>
    /// </summary>
    private static string ApuradoSobreValorMl(TotaisDosItens t)
    {
        var perdidosPorPreco = t.ItensComSobraMl - t.ItensComValorMl;
        var basico = $"sobre {t.ItensComValorMl:N0} item(ns) com cálculo do ML";
        return perdidosPorPreco > 0
            ? $"{basico} — {perdidosPorPreco:N0} ficaram fora por não ter preço de compra"
            : basico;
    }
}
