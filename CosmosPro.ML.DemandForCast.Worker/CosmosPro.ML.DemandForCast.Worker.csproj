<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>CosmosPro.ML.DemandForCast.Worker</RootNamespace>
    <UserSecretsId>worker-cosmospro-ml-demand-forecast-poc</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CosmosPro.ML.DemandForCast.ServiceDefaults\CosmosPro.ML.DemandForCast.ServiceDefaults.csproj" />
    <ProjectReference Include="..\CosmosPro.ML.DemandForCast.Engine\CosmosPro.ML.DemandForCast.Engine.csproj" />
    <ProjectReference Include="..\CosmosPro.ML.DemandForCast.Features\CosmosPro.ML.DemandForCast.Features.csproj" />
    <ProjectReference Include="..\CosmosPro.ML.DemandForCast.Forecasting\CosmosPro.ML.DemandForCast.Forecasting.csproj" />
    <ProjectReference Include="..\CosmosPro.ML.DemandForCast.Purchasing\CosmosPro.ML.DemandForCast.Purchasing.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CosmosPro.ML.DemandForCast.Worker.Tests" />
    <!-- O extrator duplica o contrato de colunas do Stage; o teste de contrato
         compara os dois para que não divirjam. -->
    <InternalsVisibleTo Include="CosmosPro.ML.DemandForCast.Extractor.Tests" />
    <!-- StageObservationLoader fala com SQL Server: só o projeto que sobe o AppHost
         real consegue exercitar o corte de treino contra um Stage de verdade. -->
    <InternalsVisibleTo Include="CosmosPro.ML.DemandForCast.ApiService.IntegrationTests" />
    <!-- O E2E da tela do comparativo semeia uma execução concluída: o ResultadoJson é
         montado com ComparacaoOutput, para que a página seja exercitada contra o contrato
         real e não contra um JSON de mentira que envelheceria sozinho. -->
    <InternalsVisibleTo Include="CosmosPro.ML.DemandForCast.Web.E2ETests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Microsoft.EntityFrameworkCore.SqlServer" Version="13.4.3" />
    <PackageReference Include="Aspire.Microsoft.Data.SqlClient" Version="13.4.3" />
    <PackageReference Include="CommunityToolkit.Aspire.Minio.Client" Version="13.3.0" />
    <PackageReference Include="CsvHelper" Version="33.1.0" />
  </ItemGroup>

</Project>
